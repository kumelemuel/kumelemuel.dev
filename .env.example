# Copy to .env for local development. In production, set these in Vercel → Project → Settings → Environment Variables.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where contact form messages are delivered
CONTACT_TO_EMAIL=kumelemuel@gmail.com

# Sender. Until kumelemuel.dev is verified in Resend, keep onboarding@resend.dev
# (it can only deliver to the email that owns the Resend account).
# CONTACT_FROM_EMAIL="Kumelemuel.dev <contacto@kumelemuel.dev>"

# Contact form rate limit (3 sends per IP per hour). Created by the Upstash integration on
# Vercel (prefix KL_). Use the read-write token, not KL_KV_REST_API_READ_ONLY_TOKEN.
# Only a SHA-256 hash of the IP is stored, and it expires after one hour.
KL_KV_REST_API_URL=https://xxxx.upstash.io
KL_KV_REST_API_TOKEN=xxxxxxxxxxxx
