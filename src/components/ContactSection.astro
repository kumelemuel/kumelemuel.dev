---
/** Shared wrapper of /contact/ and /contact/sent/: intro text + the form (or its result). */
interface Props {
  intro: string;
}
const { intro } = Astro.props;
---

<section class="contact-wrapper">
  <p class="contact-intro">{intro}</p>
  <slot />
</section>

<style>
  .contact-wrapper {
    width: min(720px, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--margin-block);
  }

  .contact-intro {
    margin: 0 auto;
    max-width: 60ch;
    color: var(--color-text-muted);
    text-align: center;
    line-height: var(--line-height-relaxed);
    font-size: var(--text-size-base);
  }
</style>
