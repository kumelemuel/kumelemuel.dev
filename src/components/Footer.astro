---
import { DEFAULT_LANG, type Lang, isLang } from "../i18n/config";
import { t } from "../i18n/ui";

const requestedLang = Astro.props.lang as Lang | undefined;
const lang = isLang(requestedLang) ? requestedLang : DEFAULT_LANG;
const messages = t(lang);
const basePath = `/${lang}`;
---

<footer>
  <div class="footer-content">
    <nav>
      <ul>
        <li><a href={`${basePath}/privacy`}>{messages.footer.privacyLink}</a></li>
      </ul>
    </nav>
    <div class="social-links">
      <a href="https://github.com/kumelemuel" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <sl-icon class="social-link-icon" name="fab-github" library="fa"></sl-icon>
      </a>
      <a href="https://www.linkedin.com/in/diego-arenas-75043b151/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <sl-icon class="social-link-icon" name="fab-linkedin" library="fa"></sl-icon>
      </a>
    </div>
    <div class="copyright">&copy; 2026 Kumelemuel.dev. {messages.footer.rights}</div>
  </div>
</footer>

<style>
  footer {
    background-color: #2E1B14;
  }

  .footer-content {
    font-family: var(--font-primary),serif;
    font-weight: var(--font-weight-regular);
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    font-size: var(--text-size-sm);
    background-color: #2D1B12;
    color: #E8E0D5;
    padding: 1rem var(--margin-page);
    text-align: center;
  }

  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .social-link-icon {
    font-size: 1.3rem;
    color: #C4B8A8;
    transition: color 0.2s ease;
  }

  .social-link-icon:hover {
    color: #A8D08D;
  }

  .footer-content nav ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }

  .footer-content nav ul li {
    display: inline;
    margin: 0 1.5rem 0 0;
  }

  .footer-content nav ul li a {
    color: #C4B8A8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-content nav ul li a:hover {
    color: #A8D08D;
  }

  @media (max-width: 700px) {
    .footer-content {
      font-size: var(--text-size-xs);
      padding: 0.75rem 1.25rem;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .footer-content nav ul li {
      margin: 0 0.75rem 0 0;
    }
  }
</style>
