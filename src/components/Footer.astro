---
import { DEFAULT_LANG, type Lang, isLang } from "../i18n/config";
import { localePath } from "../i18n/routes";
import { t } from "../i18n/ui";
import { SITE } from "../site";
import Icon from "./Icon.astro";

const requestedLang = Astro.props.lang as Lang | undefined;
const lang = isLang(requestedLang) ? requestedLang : DEFAULT_LANG;
const messages = t(lang);
---

<footer>
  <div class="footer-content">
    <nav>
      <ul>
        <li>
          <a href={localePath(lang, "privacy")}>{messages.footer.privacyLink}</a>
        </li>
      </ul>
    </nav>
    <div class="social-links">
      <a href={SITE.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <Icon name="github-logo" class="social-link-icon" />
      </a>
      <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <Icon name="linkedin-logo" class="social-link-icon" />
      </a>
    </div>
    <div class="copyright">
      &copy; {new Date().getFullYear()} Kumelemuel.dev. {messages.footer.rights}
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: var(--color-footer-background);
    border-top: 1px solid var(--color-border);
  }

  .footer-content {
    font-family: var(--font-primary), serif;
    font-weight: var(--font-weight-regular);
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    font-size: var(--text-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    background-color: var(--color-footer-background);
    color: var(--color-footer-text);
    padding: 1rem var(--margin-page);
    text-align: center;
  }

  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .social-links :global(.social-link-icon) {
    font-size: 1.3rem;
    color: var(--color-footer-link);
    transition: color 0.2s ease;
  }

  .social-links a:hover :global(.social-link-icon) {
    color: var(--color-footer-link-hover);
  }

  .footer-content nav ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }

  .footer-content nav ul li {
    display: inline;
    margin: 0 1.5rem 0 0;
  }

  .footer-content nav ul li a {
    color: var(--color-footer-link);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-content nav ul li a:hover {
    color: var(--color-footer-link-hover);
  }

  @media (max-width: 700px) {
    .footer-content {
      font-size: var(--text-size-xs);
      padding: 0.75rem 1.25rem;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .footer-content nav ul li {
      margin: 0 0.75rem 0 0;
    }
  }
</style>
