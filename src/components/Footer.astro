---
import { DEFAULT_LANG, type Lang, isLang } from "../i18n/config";
import { t } from "../i18n/ui";

const requestedLang = Astro.props.lang as Lang | undefined;
const lang = isLang(requestedLang) ? requestedLang : DEFAULT_LANG;
const messages = t(lang);
const basePath = `/${lang}`;
---

<footer>
  <div class="footer-content">
    <nav>
      <ul>
        <li><a href={`${basePath}/privacy`}>{messages.footer.privacy}</a></li>
        <li><a href={`${basePath}/terms`}>{messages.footer.terms}</a></li>
        <li><a href={`${basePath}/contact`}>{messages.footer.contact}</a></li>
      </ul>
    </nav>
    <div class="social-links">
      <a href="https://github.com/kumelemuel" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <sl-icon class="social-link-icon" name="fab-github" library="fa"></sl-icon>
      </a>
      <a href="https://www.linkedin.com/in/diego-arenas-75043b151/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <sl-icon class="social-link-icon" name="fab-linkedin" library="fa"></sl-icon>
      </a>
    </div>
    <div>&copy; 2026 Kumelemuel.dev. {messages.footer.rights}</div>
  </div>
</footer>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400&display=swap');

  .footer-content {
    font-family: 'Noto Sans JP', sans-serif;
    font-weight: 300;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    font-size: .9rem;
    background-color: var(--color-background-secondary);
    color: var(--color-text-gray);
    padding: .7rem 2rem;
    text-align: center;
    border-top: 1px solid var(--color-gray-strong);
  }
  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .9rem;
  }
  .social-link-icon {
    font-size: 1.4rem;
    color: var(--color-text-gray);
    transition: color .2s ease;
  }
  .social-link-icon:hover {
    color: var(--color-text-main);
  }
  .footer-content nav ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }
  .footer-content nav ul li {
    display: inline;
    margin: 0 2rem 0 0;
  }
  .footer-content nav ul li a {
    color: var(--color-text-gray);
    text-decoration: none;
  }
  .footer-content nav ul li a:hover {
    color: var(--color-text-accent);
  }
  @media (max-width: 700px) {
    .footer-content {
      font-size: .75rem;
      padding: .5rem 1rem;
      gap: .8rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .footer-content nav ul li {
      margin: 0 .6rem 0 0;
    }
  }
</style>
