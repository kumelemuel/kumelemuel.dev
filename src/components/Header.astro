---
import { DEFAULT_LANG, SUPPORTED_LANGS, type Lang, isLang } from "../i18n/config";
import { localePath, type Alternates } from "../i18n/routes";
import { t } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  lang?: string;
  /** Path of the current page in each language; languages without it link to their home. */
  alternates?: Alternates;
}

const requestedLang = Astro.props.lang;
const alternates = Astro.props.alternates ?? {};
const lang = isLang(requestedLang) ? requestedLang : DEFAULT_LANG;
const messages = t(lang);

const homePath = localePath(lang, "home");
const menu = [
  { name: messages.header.home, path: homePath },
  { name: messages.header.who, path: localePath(lang, "who") },
  { name: messages.header.articles, path: localePath(lang, "articles") },
  { name: messages.header.contact, path: localePath(lang, "contact") },
];

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.endsWith("/") ? pathname : `${pathname}/`;

// Home is only active on itself; sections also on their subpages (e.g. an article).
const isActive = (path: string) => (path === homePath ? currentPath === path : currentPath.startsWith(path));

const localizedPath = (targetLang: Lang) => alternates[targetLang] ?? localePath(targetLang, "home");
---

<header>
  <a href={homePath} class="brand">
    <span class="brand-text">Kumelemuel.dev</span>
  </a>
  <button
    class="menu-toggle"
    id="menu-toggle"
    type="button"
    aria-controls="nav-menu"
    aria-expanded="false"
    aria-label={messages.header.openMenu}
    data-label-open={messages.header.openMenu}
    data-label-close={messages.header.closeMenu}
  >
    <Icon name="list" class="menu-icon-open" />
    <Icon name="x" class="menu-icon-close" />
  </button>
  <nav class="nav-menu" id="nav-menu" aria-label={messages.header.mainNav}>
    <div class="nav-content">
      {menu.map((item) => (
        <a
          href={item.path}
          class={isActive(item.path) ? "active" : ""}
          aria-current={isActive(item.path) ? "page" : undefined}
        >
          {item.name}
        </a>
      ))}
      <div class="lang-switcher">
        {SUPPORTED_LANGS.map((currentLang) => (
          <a
            href={localizedPath(currentLang)}
            class={currentLang === lang ? "active-lang" : ""}
            hreflang={currentLang}
            aria-label={`${currentLang.toUpperCase()} — ${messages.header.switchLanguage[currentLang]}`}
            aria-current={currentLang === lang ? "true" : undefined}
          >
            {currentLang.toUpperCase()}
          </a>
        ))}
      </div>
    </div>
  </nav>
  <div class="menu-overlay" id="menu-overlay"></div>
</header>

<script>
  // Module-level controller so listeners from the previous page are removed on each navigation.
  let controller: AbortController | undefined;

  function setupMenu() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const menuToggle = document.getElementById("menu-toggle");
    const navMenu = document.getElementById("nav-menu");
    const menuOverlay = document.getElementById("menu-overlay");
    if (!menuToggle || !navMenu) return;

    const mobileQuery = window.matchMedia("(max-width: 900px)");

    const setOpen = (open: boolean) => {
      navMenu.classList.toggle("menu-open", open);
      menuOverlay?.classList.toggle("menu-open", open);
      document.body.classList.toggle("menu-locked", open);
      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute(
        "aria-label",
        (open ? menuToggle.dataset.labelClose : menuToggle.dataset.labelOpen) ?? "Menu",
      );
      // Off-screen menu must not be reachable by keyboard or screen readers.
      navMenu.inert = mobileQuery.matches && !open;
    };

    const isOpen = () => navMenu.classList.contains("menu-open");

    menuToggle.addEventListener("click", () => setOpen(!isOpen()), { signal });
    menuOverlay?.addEventListener("click", () => setOpen(false), { signal });
    navMenu.addEventListener(
      "click",
      (event) => {
        if ((event.target as HTMLElement).closest("a")) setOpen(false);
      },
      { signal },
    );
    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && isOpen()) {
          setOpen(false);
          menuToggle.focus();
        }
      },
      { signal },
    );
    mobileQuery.addEventListener("change", () => setOpen(false), { signal });

    setOpen(false);
  }

  document.addEventListener("astro:page-load", setupMenu);
</script>

<style>
  header {
    font-family: var(--font-primary), serif;
    font-size: var(--text-size-xs);
    font-weight: var(--font-weight-regular);
    background-color: var(--color-background);
    color: var(--color-text-secondary);
    padding: 1rem var(--margin-page);
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 1000;
    border-bottom: 1px solid var(--color-border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }

  .brand-text {
    font-family: var(--font-secondary), serif;
    font-size: var(--text-size-xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-text-main);
    transition: all 0.3s ease;
  }

  .brand:hover .brand-text {
    color: var(--color-brand-text);
    scale: 1.07;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--color-text-main);
    font-size: var(--text-size-xl);
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1001;
  }

  /* Both icons are rendered; aria-expanded picks the visible one (no JS swap). */
  .menu-toggle :global(.menu-icon-close),
  .menu-toggle[aria-expanded="true"] :global(.menu-icon-open) {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] :global(.menu-icon-close) {
    display: inline-block;
  }

  .nav-menu {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 2rem;
  }

  .nav-content {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-menu a {
    font-size: 0.95em;
    color: var(--color-text-secondary);
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.5s ease;
    letter-spacing: var(--letter-spacing-widest);
  }

  .nav-menu a.active {
    color: var(--color-brand-text);
  }

  .nav-menu a:hover {
    color: var(--color-brand-text);
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: 0.5rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-border);
  }

  /* Padded to a 24px touch target (WCAG 2.5.8) despite the small type. */
  .lang-switcher a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    font-size: 0.85em;
    letter-spacing: 0.05em;
  }

  .active-lang {
    color: var(--color-brand-text) !important;
  }

  .menu-overlay {
    display: none;
  }

  @media (max-width: 900px) {
    .menu-toggle {
      display: block;
      color: var(--color-text-main);
    }

    .menu-toggle[aria-expanded="true"] {
      color: var(--color-brand);
    }

    .nav-menu {
      position: fixed;
      top: 0;
      right: -100%;
      width: 100%;
      height: 100dvh;
      background-color: var(--color-background);
      flex-direction: column;
      justify-content: center;
      gap: 0;
      transition: right 0.3s ease;
      z-index: 1000;
    }

    .nav-menu.menu-open {
      right: 0;
    }

    .menu-overlay {
      display: block;
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.7);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      z-index: 999;
    }

    .menu-overlay.menu-open {
      opacity: 1;
      pointer-events: auto;
    }

    .nav-content {
      flex-direction: column;
      gap: 2rem;
    }

    .nav-menu a {
      font-size: var(--text-size-lg);
      color: var(--color-text-main);
    }

    .nav-menu a.active {
      color: var(--color-brand);
    }

    .nav-menu a:hover {
      color: var(--color-brand);
    }

    .lang-switcher {
      padding-left: 0;
      padding-top: 1.5rem;
      border-left: none;
      border-top: 1px solid var(--color-border);
    }

    .lang-switcher a {
      color: var(--color-text-secondary);
    }

    .active-lang {
      color: var(--color-brand) !important;
    }

    :global(body.menu-locked) {
      overflow: hidden;
    }
  }

  @media (max-width: 700px) {
    header {
      padding: 1rem 1.25rem;
    }

    .brand-text {
      font-size: 1.1rem;
    }
  }
</style>
