---
import { DEFAULT_LANG, SUPPORTED_LANGS, type Lang, isLang } from "../i18n/config";
import { t } from "../i18n/ui";

const requestedLang = Astro.props.lang as Lang | undefined;
const lang = isLang(requestedLang) ? requestedLang : DEFAULT_LANG;
const messages = t(lang);

const basePath = `/${lang}`;
const menu = [
  { name: messages.header.home, path: `${basePath}/` },
  { name: messages.header.who, path: `${basePath}/who-am-i` },
  { name: messages.header.portfolio, path: `${basePath}/portfolio` },
  { name: messages.header.articles, path: `${basePath}/articles` },
  { name: messages.header.contact, path: `${basePath}/contact` },
];

const pathname = new URL(Astro.request.url).pathname;
const cleanPathname = pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const cleanPath = path.endsWith("/") && path !== "/" ? path.slice(0, -1) : path;
  if (cleanPath === `/${lang}`) {
    return cleanPathname === cleanPath;
  }
  return cleanPathname === cleanPath || cleanPathname.startsWith(`${cleanPath}/`);
};

const localizedPath = (targetLang: Lang) => {
  const segments = pathname.split("/").filter(Boolean);
  const remainingSegments = isLang(segments[0]) ? segments.slice(1) : segments;
  return `/${targetLang}/${remainingSegments.join("/")}`.replace(/\/$/, "") + "/";
};
---

<header>
  <span class="brand">kumelemuel.dev</span>
  <nav>
    {menu.map((item) => (
      <a href={item.path} class={isActive(item.path) ? "active" : ""}>{item.name}</a>
    ))}
    <div class="lang-switcher">
      {SUPPORTED_LANGS.map((currentLang) => (
        <a
          href={localizedPath(currentLang)}
          class={currentLang === lang ? "active-lang" : ""}
          aria-label={`Switch language to ${currentLang.toUpperCase()}`}
        >
          {currentLang.toUpperCase()}
        </a>
      ))}
    </div>
  </nav>
</header>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;700&family=Sawarabi+Mincho&display=swap');

  header {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: clamp(.9rem, 1.08vw, 1.02rem);
    font-weight: 300;
    background-color: var(--color-background-secondary);
    color: var(--color-text-secondary);
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 1000;
    box-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);
  }
  .brand {
    font-family: 'Sawarabi Mincho', serif;
    font-size: 1.18em;
    font-weight: 900;
  }
  nav {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.6rem;
  }
  a {
    font-size: .95em;
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  a.active {
    font-weight: bold;
    color: var(--color-text-accent-strong);
    text-decoration: none;
  }
  a:hover {
    text-decoration: none;
    color: var(--color-text-accent);
  }
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: .45rem;
    margin-left: .3rem;
    padding-left: .8rem;
    border-left: 1px solid var(--color-gray-strong);
  }
  .active-lang {
    color: var(--color-text-accent);
    font-weight: bold;
  }
  @media (max-width: 600px) {
    nav {
      gap: .75rem;
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    header {
      padding: .7rem 1rem;
    }
    .lang-switcher {
      padding-left: .5rem;
    }
  }
</style>
