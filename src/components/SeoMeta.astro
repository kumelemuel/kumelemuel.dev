---
import { DEFAULT_LANG, SUPPORTED_LANGS, type Lang } from "../i18n/config";
import type { Alternates } from "../i18n/routes";
import { SITE } from "../site";

export interface ArticleMeta {
  publishedAt: Date;
  updatedAt?: Date;
  tags: readonly string[];
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalURL?: string;
  lang?: Lang;
  /** Path of this same page in each language it exists in (for hreflang and og:locale:alternate). */
  alternates?: Alternates;
  type?: "website" | "article";
  /** Only for type="article": dates and tags for Open Graph and BlogPosting. */
  article?: ArticleMeta;
  noindex?: boolean;
}

const OG_LOCALES: Record<Lang, string> = {
  es: "es_MX",
  en: "en_US",
};

const HREFLANGS: Record<Lang, string> = {
  es: "es-MX",
  en: "en",
};

const {
  title,
  description = "Software engineer building projects with judgment, structure, and human purpose. Open source, digital governance, and systems that integrate technical and human concerns.",
  image = "/og-image.png",
  imageAlt = "Kumelemuel.dev — Diego Arenas, software engineer",
  canonicalURL,
  lang = DEFAULT_LANG,
  alternates: alternatePaths = {},
  type = "website",
  article,
  noindex = false,
} = Astro.props;

const siteTitle = SITE.name;
const fullTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const url = canonicalURL || Astro.url.href;
const absoluteImage = new URL(image, Astro.site).href;

// Translated slugs: each language has its own path, so it comes from the page (src/i18n/routes.ts).
const alternateLangs = SUPPORTED_LANGS.filter((altLang) => alternatePaths[altLang]);
const absoluteURL = (path: string) => new URL(path, Astro.site).href;
const alternates = alternateLangs.map((altLang) => ({
  hreflang: HREFLANGS[altLang],
  href: absoluteURL(alternatePaths[altLang]!),
}));
const xDefaultLang = alternateLangs.includes(DEFAULT_LANG) ? DEFAULT_LANG : alternateLangs[0];

// Structured data: one @graph so the article can reference the author and site by @id.
const siteURL = new URL("/", Astro.site).href;
const personId = `${siteURL}#person`;
const websiteId = `${siteURL}#website`;
const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: siteURL,
    name: siteTitle,
    inLanguage: SUPPORTED_LANGS.map((l) => HREFLANGS[l]),
    publisher: { "@id": personId },
  },
  {
    "@type": "Person",
    "@id": personId,
    name: SITE.author.name,
    url: siteURL,
    jobTitle: SITE.author.jobTitle,
    sameAs: Object.values(SITE.social),
  },
];
if (type === "article" && article) {
  graph.push({
    "@type": "BlogPosting",
    "@id": `${url}#article`,
    mainEntityOfPage: url,
    url,
    headline: title,
    description,
    image: absoluteImage,
    inLanguage: HREFLANGS[lang],
    datePublished: article.publishedAt.toISOString(),
    dateModified: (article.updatedAt ?? article.publishedAt).toISOString(),
    keywords: article.tags.join(", "),
    author: { "@id": personId },
    publisher: { "@id": personId },
    isPartOf: { "@id": websiteId },
  });
}
// Escape "<" so a title containing "</script>" cannot close the tag early.
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />

{!noindex && alternates.length > 1 && (
  <>
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absoluteURL(alternatePaths[xDefaultLang]!)} />
  </>
)}

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content={OG_LOCALES[lang]} />
{alternateLangs
  .filter((altLang) => altLang !== lang)
  .map((altLang) => (
    <meta property="og:locale:alternate" content={OG_LOCALES[altLang]} />
  ))}
<meta property="og:type" content={type} />
{type === "article" && article && (
  <>
    <meta property="article:published_time" content={article.publishedAt.toISOString()} />
    {article.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()} />}
    <meta property="article:author" content={SITE.author.name} />
    {article.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<script type="application/ld+json" set:html={jsonLd} />
