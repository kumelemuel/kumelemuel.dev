---
import { DEFAULT_LANG, SUPPORTED_LANGS, type Lang } from "../i18n/config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalURL?: string;
  lang?: Lang;
  /** Languages in which this same page exists (for hreflang). Defaults to all. */
  alternateLangs?: readonly Lang[];
  type?: "website" | "article";
  noindex?: boolean;
}

const OG_LOCALES: Record<Lang, string> = {
  es: "es_MX",
  en: "en_US",
};

const HREFLANGS: Record<Lang, string> = {
  es: "es-MX",
  en: "en",
};

const {
  title,
  description = "Software engineer building projects with judgment, structure, and human purpose. Open source, digital governance, and systems that integrate technical and human concerns.",
  image = "/og-image.png",
  imageAlt = "Kumelemuel.dev — Diego Arenas, software engineer",
  canonicalURL,
  lang = DEFAULT_LANG,
  alternateLangs = SUPPORTED_LANGS,
  type = "website",
  noindex = false,
} = Astro.props;

const siteTitle = "Kumelemuel";
const fullTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const url = canonicalURL || Astro.url.href;
const absoluteImage = new URL(image, Astro.site).href;

// Same path in another language: swap the leading /{lang}/ segment.
const localizedURL = (targetLang: Lang) =>
  new URL(
    Astro.url.pathname.replace(/^\/[^/]+/, `/${targetLang}`),
    Astro.site,
  ).href;

const alternates = alternateLangs.map((altLang) => ({
  hreflang: HREFLANGS[altLang],
  href: localizedURL(altLang),
}));
const xDefaultLang = alternateLangs.includes(DEFAULT_LANG) ? DEFAULT_LANG : alternateLangs[0];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />

{!noindex && alternates.length > 1 && (
  <>
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={localizedURL(xDefaultLang)} />
  </>
)}

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content={OG_LOCALES[lang]} />
{alternateLangs
  .filter((altLang) => altLang !== lang)
  .map((altLang) => <meta property="og:locale:alternate" content={OG_LOCALES[altLang]} />)}
<meta property="og:type" content={type} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{noindex && <meta name="robots" content="noindex, nofollow" />}
