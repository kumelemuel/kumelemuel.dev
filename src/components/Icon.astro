---
/**
 * Inline SVG icon from src/icons/<name>.svg (Font Awesome 5 Free, CC BY 4.0; license kept in each file).
 * Rendered at build time: no JS, no extra request, inherits `color` and scales with `font-size`.
 * Decorative by default (aria-hidden); pass `label` when the icon is the only content of a control.
 */
const icons = import.meta.glob<string>("../icons/*.svg", { query: "?raw", import: "default", eager: true });

interface Props {
  name: string;
  class?: string;
  label?: string;
}

const { name, class: className, label } = Astro.props;
const svg = icons[`../icons/${name}.svg`];
if (!svg) {
  throw new Error(`Icon "${name}" not found in src/icons/. Available: ${Object.keys(icons).join(", ")}`);
}

const escapeAttr = (value: string) => value.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
const a11y = label ? `role="img" aria-label="${escapeAttr(label)}"` : `aria-hidden="true" focusable="false"`;
const classes = ["icon", className].filter(Boolean).join(" ");
const html = svg.replace(/<svg\b/, `<svg class="${escapeAttr(classes)}" width="1em" height="1em" fill="currentColor" ${a11y}`);
---

<Fragment set:html={html} />
