---
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../i18n/config";
import { routeAlternates } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const messages = t(lang);
---

<Layout
  title={messages.pages.privacy.title}
  lang={lang}
  description={messages.pages.privacy.description}
  alternates={routeAlternates("privacy")}
  noindex
>
  <div class="privacy-content" set:html={messages.pages.privacy.bodyHtml} />
</Layout>

<style>
  .privacy-content {
    width: min(800px, 100%);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    font-size: var(--text-size-base);
  }

  .privacy-content :global(h1) {
    margin: 0 0 var(--margin-block);
    font-family: var(--font-secondary), serif;
    font-size: var(--text-size-4xl);
    font-weight: var(--font-weight-light);
    color: var(--color-text-main);
  }

  .privacy-content :global(h2) {
    margin: var(--margin-block) 0 var(--margin-element);
    font-family: var(--font-secondary), serif;
    font-size: var(--text-size-2xl);
    font-weight: var(--font-weight-light);
    color: var(--color-text-main);
  }

  .privacy-content :global(p),
  .privacy-content :global(ul) {
    margin: 0 0 var(--margin-element);
  }

  .privacy-content :global(a) {
    /* Underlined so links in running text do not rely on color alone (WCAG 1.4.1). */
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--color-brand-text);
    transition: color 0.2s ease;
  }

  .privacy-content :global(a:hover) {
    color: var(--color-brand-hover);
  }
</style>
