---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import type { Lang } from "../i18n/config";
import { projectPath, routeAlternates } from "../i18n/routes";
import { t } from "../i18n/ui";
import { getProjectsByLang } from "../utils/portfolio";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const messages = t(lang);
const copy = messages.pages.portfolio;
const projects = await getProjectsByLang(lang);
const featured = projects.filter(({ project }) => project.data.kind === "featured");
const lab = projects.filter(({ project }) => project.data.kind === "lab");
---

<Layout
  title={copy.title}
  lang={lang}
  description={copy.description}
  alternates={routeAlternates("portfolio")}
>
  <div class="portfolio">
    <p class="portfolio-intro">{copy.intro}</p>

    {projects.length === 0 && <p class="empty-state">{copy.empty}</p>}

    {featured.length > 0 && (
      <section class="block" aria-labelledby="featured-heading">
        <h2 class="block-heading" id="featured-heading">
          {copy.featuredHeading}
        </h2>
        <div class="featured-list">
          {featured.map(({ project, slug }) => (
            <article class="featured-card">
              {project.data.cover && (
                <a href={projectPath(lang, slug)} class="featured-cover" tabindex="-1" aria-hidden="true">
                  <Picture
                    src={project.data.cover}
                    alt=""
                    formats={["avif", "webp"]}
                    fallbackFormat="webp"
                    widths={[480, 720, 960]}
                    sizes="(min-width: 900px) 540px, 100vw"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <div class="featured-body">
                <p class="status">{copy.statuses[project.data.status]}</p>
                <h3 class="project-title">
                  <a href={projectPath(lang, slug)}>{project.data.title}</a>
                </h3>
                <p class="project-summary">{project.data.summary}</p>
                <ul class="stack" aria-label={copy.stack}>
                  {project.data.stack.map((tech) => (
                    <li>{tech}</li>
                  ))}
                </ul>
                <div class="actions">
                  <a class="button" href={projectPath(lang, slug)}>
                    {copy.caseStudy}
                    <Icon name="arrow-right" class="action-icon" />
                  </a>
                  {project.data.links.site && (
                    <a
                      class="text-link"
                      href={project.data.links.site}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {copy.visitSite}
                      <Icon name="arrow-up-right" class="action-icon" />
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    {featured.length > 0 && lab.length > 0 && (
      <div class="ornament" aria-hidden="true">
        <span />
      </div>
    )}

    {lab.length > 0 && (
      <section class="block" aria-labelledby="lab-heading">
        <h2 class="block-heading" id="lab-heading">
          {copy.labHeading}
        </h2>
        <p class="block-intro">{copy.labIntro}</p>
        <div class="lab-grid">
          {lab.map(({ project, slug }) => (
            <article class="lab-card">
              <div class="lab-top">
                <Icon name="flask" class="lab-icon" />
                <p class="status">{copy.statuses[project.data.status]}</p>
              </div>
              <h3 class="project-title">
                <a href={projectPath(lang, slug)}>{project.data.title}</a>
              </h3>
              <p class="project-summary">{project.data.summary}</p>
              <ul class="stack" aria-label={copy.stack}>
                {project.data.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
              <div class="actions">
                <a class="text-link" href={projectPath(lang, slug)}>
                  {copy.caseStudy}
                  <Icon name="arrow-right" class="action-icon" />
                </a>
                {project.data.links.repo && (
                  <a
                    class="text-link"
                    href={project.data.links.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name="github-logo" class="action-icon" />
                    GitHub
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .portfolio {
    width: min(1100px, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--margin-block);
  }

  .portfolio-intro,
  .empty-state {
    margin: 0 auto;
    max-width: 60ch;
    text-align: center;
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: var(--margin-element);
  }

  .block-heading {
    margin: 0;
    font-family: var(--font-primary), serif;
    font-size: var(--text-size-sm);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    color: var(--color-brand-display);
  }

  .block-intro {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-size-sm);
    line-height: var(--line-height-relaxed);
  }

  /* Shared card pieces */
  .status {
    margin: 0;
    font-size: var(--text-size-xs);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-brand-display);
  }

  .project-title {
    margin: 0;
    font-family: var(--font-secondary), serif;
    font-size: var(--text-size-xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-text-main);
  }

  .project-title a:hover {
    color: var(--color-brand-text);
  }

  .project-summary {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    margin: 0;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    font-size: var(--text-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 24px;
    font-size: var(--text-size-sm);
    color: var(--color-brand-text);
  }

  .text-link:hover {
    color: var(--color-brand-hover);
  }

  .actions :global(.action-icon) {
    transition: transform 0.2s ease;
  }

  .actions a:hover :global(.action-icon) {
    transform: translateX(2px);
  }

  /* Featured: image beside the text on wide screens */
  .featured-list {
    display: flex;
    flex-direction: column;
    gap: var(--margin-block);
  }

  .featured-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background-color: var(--color-background-card);
    border: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border-gold);
    border-radius: 2px;
    overflow: hidden;
  }

  .featured-cover {
    display: block;
    border-bottom: 1px solid var(--color-border);
  }

  .featured-cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  @media (min-width: 900px) {
    .featured-card {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }

    .featured-cover {
      border-bottom: none;
      border-right: 1px solid var(--color-border);
    }
  }

  /* Lab: compact cards */
  .lab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
  }

  .lab-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    background-color: var(--color-background-card);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-border-gold);
    border-radius: 2px;
    transition: border-color 0.3s ease;
  }

  .lab-card:hover {
    border-color: var(--color-border-gold);
  }

  .lab-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .lab-top :global(.lab-icon) {
    font-size: 1.5rem;
    color: var(--color-brand-display);
  }

  .lab-card .project-title {
    font-size: var(--text-size-lg);
  }
</style>
