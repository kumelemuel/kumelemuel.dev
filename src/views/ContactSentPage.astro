---
// Result of the contact form submitted without JavaScript (with JS the form talks to the
// action directly and never navigates here). Rendered by the on-demand pages
// src/pages/es/contacto/enviado.astro and src/pages/en/contact/sent.astro, which redirect
// direct visits (nothing submitted) back to the form.
import { actions, isInputError } from "astro:actions";
import Layout from "../layouts/Layout.astro";
import ContactSection from "../components/ContactSection.astro";
import Icon from "../components/Icon.astro";
import ContactForm, { type ContactField } from "../components/ContactForm.astro";
import type { Lang } from "../i18n/config";
import { localePath, routeAlternates } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const result = Astro.getActionResult(actions.contact);
const messages = t(lang);
const contact = messages.pages.contact;

let success = "";
let formError = "";
const errors: Partial<Record<ContactField, string>> = {};
const values: Partial<Record<ContactField, string>> = {};

if (result?.error) {
  if (isInputError(result.error)) {
    for (const issue of result.error.issues) {
      const field = issue.path[0];
      if ((field === "name" || field === "email" || field === "message") && !errors[field]) {
        errors[field] = issue.message;
      }
    }
  }
  if (Object.keys(errors).length === 0) {
    formError = result.error.message || contact.submitUnexpectedError;
  }
  // Keep what the person typed (Astro leaves the request body readable after the action).
  try {
    const form = await Astro.request.formData();
    for (const field of ["name", "email", "message"] as const) {
      const value = form.get(field);
      if (typeof value === "string") values[field] = value;
    }
  } catch {
    // Body unavailable: the form is rendered empty, errors are still shown.
  }
} else if (result) {
  success = `${contact.successTitle} ${result.data.message}`.trim();
}
---

<Layout
  title={contact.title}
  lang={lang}
  description={contact.intro}
  alternates={routeAlternates("contact")}
  noindex
>
  <ContactSection intro={contact.intro}>
    {success ? (
      <div class="sent">
        <p class="sent-message" role="status">
          <Icon name="check-circle" class="sent-icon" />
          {success}
        </p>
        <a class="button" href={localePath(lang, "home")}>
          {messages.header.home}
        </a>
      </div>
    ) : (
      <ContactForm lang={lang} values={values} errors={errors} formError={formError} startedAt={Date.now()} />
    )}
  </ContactSection>
</Layout>

<style>
  .sent {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-element);
    text-align: center;
  }

  .sent-message {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.875rem 1rem;
    border: 1px solid rgba(143, 191, 127, 0.35);
    border-radius: 2px;
    background-color: rgba(143, 191, 127, 0.08);
    color: var(--color-success);
    font-size: var(--text-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .sent-message :global(.sent-icon) {
    flex-shrink: 0;
    font-size: 1.25em;
  }
</style>
