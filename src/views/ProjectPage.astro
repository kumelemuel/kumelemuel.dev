---
import { Picture } from "astro:assets";
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import type { Lang } from "../i18n/config";
import { localePath, type Alternates } from "../i18n/routes";
import { t } from "../i18n/ui";
import type { Project } from "../utils/portfolio";

interface Props {
  lang: Lang;
  project: Project;
  /** This project in each language it has been translated to (see getProjectStaticPaths). */
  alternates: Alternates;
}

const { lang, project, alternates } = Astro.props;
const { Content } = await render(project);
const copy = t(lang).pages.portfolio;
const { title, summary, status, role, year, stack, links, cover, coverAlt } = project.data;
---

<Layout title={title} lang={lang} description={summary} {alternates}>
  <article class="project">
    <div class="project-header">
      <p class="summary">{summary}</p>

      <dl class="facts">
        {role && (
          <div class="fact">
            <dt>
              <Icon name="briefcase" class="fact-icon" />
              {copy.role}
            </dt>
            <dd>{role}</dd>
          </div>
        )}
        <div class="fact">
          <dt>
            <Icon name="calendar-blank" class="fact-icon" />
            {copy.year}
          </dt>
          <dd>{year}</dd>
        </div>
        <div class="fact">
          <dt>
            <Icon name="check-circle" class="fact-icon" />
            {copy.status}
          </dt>
          <dd>{copy.statuses[status]}</dd>
        </div>
        <div class="fact fact--wide">
          <dt>
            <Icon name="stack" class="fact-icon" />
            {copy.stack}
          </dt>
          <dd>{stack.join(" · ")}</dd>
        </div>
      </dl>

      {(links.site || links.repo) && (
        <div class="links">
          {links.site && (
            <a class="button" href={links.site} target="_blank" rel="noopener noreferrer">
              {copy.visitSite}
              <Icon name="arrow-up-right" />
            </a>
          )}
          {links.repo && (
            <a class="button button--ghost" href={links.repo} target="_blank" rel="noopener noreferrer">
              <Icon name="github-logo" />
              {copy.viewCode}
            </a>
          )}
        </div>
      )}
    </div>

    {cover && (
      <figure class="cover-frame">
        <Picture
          src={cover}
          alt={coverAlt ?? ""}
          class="cover"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[480, 800, 1200]}
          sizes="(min-width: 860px) 800px, 100vw"
        />
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <a class="back" href={localePath(lang, "portfolio")}>
      <Icon name="arrow-left" class="back-icon" />
      {copy.back}
    </a>
  </article>
</Layout>

<style>
  .project {
    width: min(800px, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--margin-block);
  }

  .project-header {
    display: flex;
    flex-direction: column;
    gap: var(--margin-element);
  }

  .summary {
    margin: 0;
    text-align: center;
    color: var(--color-text-secondary);
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
    padding: 1.25rem;
    background-color: var(--color-background-card);
    border: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border-gold);
    border-radius: 2px;
  }

  .fact--wide {
    grid-column: 1 / -1;
  }

  .fact dt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.25rem;
    font-size: var(--text-size-xs);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .fact dt :global(.fact-icon) {
    font-size: 1.2em;
    color: var(--color-brand-display);
  }

  .fact dd {
    margin: 0;
    color: var(--color-text-main);
    font-size: var(--text-size-sm);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .button--ghost {
    background-color: transparent;
    color: var(--color-brand-text);
  }

  .button--ghost:hover {
    color: var(--color-on-brand);
  }

  .cover-frame {
    margin: 0;
  }

  .cover-frame :global(.cover) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: 2px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: center;
    min-height: 24px;
    font-size: var(--text-size-sm);
    color: var(--color-brand-text);
  }

  .back:hover {
    color: var(--color-brand-hover);
  }

  .back :global(.back-icon) {
    transition: transform 0.2s ease;
  }

  .back:hover :global(.back-icon) {
    transform: translateX(-3px);
  }
</style>
