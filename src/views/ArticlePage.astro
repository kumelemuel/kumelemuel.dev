---
import Layout from "../layouts/Layout.astro";
import { render } from "astro:content";
import { INTL_LOCALES, type Lang } from "../i18n/config";
import type { Alternates } from "../i18n/routes";
import { t } from "../i18n/ui";
import "../styles/prism.css";
import type { Article } from "../utils/articles";
import Icon from "../components/Icon.astro";

interface Props {
  lang: Lang;
  article: Article;
  /** This article in each language it has been translated to (see getArticleStaticPaths). */
  alternates: Alternates;
}

const { article, lang, alternates } = Astro.props;
const { Content } = await render(article);
const messages = t(lang);
const dateFormatter = new Intl.DateTimeFormat(INTL_LOCALES[lang], {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={article.data.title}
  lang={lang}
  description={article.data.description}
  type="article"
  article={{
    publishedAt: article.data.publishedAt,
    updatedAt: article.data.updatedAt,
    tags: article.data.tags,
  }}
  {alternates}
>
  <article class="article">
    <p class="meta-line">
      <span class="meta-item">
        <Icon name="calendar-blank" class="meta-icon" />
        {messages.pages.articles.published}: {dateFormatter.format(article.data.publishedAt)}
      </span>
      <span class="meta-item">
        <Icon name="tag" class="meta-icon" />
        {messages.pages.articles.tags}: {article.data.tags.join(" · ")}
      </span>
    </p>
    <p class="description">{article.data.description}</p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .article {
    width: min(800px, 100%);
    background-color: var(--color-background-card);
    border: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border-gold);
    border-radius: 2px;
    padding: var(--margin-block);
    box-sizing: border-box;
  }

  .description {
    margin: 0 0 var(--margin-element);
    color: var(--color-text-muted);
    font-size: var(--text-size-base);
    line-height: var(--line-height-relaxed);
  }

  .meta-line {
    margin: 0 0 var(--margin-element);
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-size-xs);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta-item :global(.meta-icon) {
    flex-shrink: 0;
    font-size: 1.15em;
    color: var(--color-brand-display);
  }
</style>
