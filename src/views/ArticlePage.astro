---
import Layout from "../layouts/Layout.astro";
import { render } from "astro:content";
import { INTL_LOCALES, type Lang } from "../i18n/config";
import type { Alternates } from "../i18n/routes";
import { t } from "../i18n/ui";
import "../styles/prism.css";
import type { Article } from "../utils/articles";

interface Props {
  lang: Lang;
  article: Article;
  /** This article in each language it has been translated to (see getArticleStaticPaths). */
  alternates: Alternates;
}

const { article, lang, alternates } = Astro.props;
const { Content } = await render(article);
const messages = t(lang);
const dateFormatter = new Intl.DateTimeFormat(INTL_LOCALES[lang], {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={article.data.title}
  lang={lang}
  description={article.data.description}
  type="article"
  article={{
    publishedAt: article.data.publishedAt,
    updatedAt: article.data.updatedAt,
    tags: article.data.tags,
  }}
  {alternates}
>
  <article class="article">
    <p class="meta-line">
      <span>
        {messages.pages.articles.published}: {dateFormatter.format(article.data.publishedAt)}
      </span>
      <span>
        {messages.pages.articles.tags}: {article.data.tags.join(" · ")}
      </span>
    </p>
    <p class="description">{article.data.description}</p>
    <div class="article-body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .article {
    width: min(800px, 100%);
    background-color: var(--color-background-card);
    border: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border-gold);
    border-radius: 2px;
    padding: var(--margin-block);
    box-sizing: border-box;
  }

  .description {
    margin: 0 0 var(--margin-element);
    color: var(--color-text-muted);
    font-size: var(--text-size-base);
    line-height: var(--line-height-relaxed);
  }

  .meta-line {
    margin: 0 0 var(--margin-element);
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-size-xs);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
  }

  .article-body {
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    font-size: var(--text-size-base);
  }

  .article-body :global(p) {
    margin: 0 0 var(--margin-element);
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    font-family: var(--font-secondary), sans-serif;
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-brand-display);
    margin: var(--margin-block) 0 var(--margin-element);
  }

  .article-body :global(h2) {
    font-size: var(--text-size-2xl);
  }

  .article-body :global(h3) {
    font-size: var(--text-size-xl);
  }

  .article-body :global(a) {
    /* Underlined so links in running text do not rely on color alone (WCAG 1.4.1). */
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--color-brand-text);
    transition: color 0.2s ease;
  }

  .article-body :global(a:hover) {
    color: var(--color-brand-hover);
  }

  .article-body :global(code) {
    background: var(--color-background-elevated);
    padding: 0.2em 0.4em;
    border-radius: 2px;
    font-size: 0.9em;
  }

  .article-body :global(pre) {
    background: var(--color-background-elevated);
    padding: var(--margin-element);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    overflow-x: auto;
  }

  .article-body :global(pre code) {
    background: none;
    padding: 0;
  }
</style>
