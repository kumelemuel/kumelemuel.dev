---
import Layout from "../layouts/Layout.astro";
import { INTL_LOCALES, type Lang } from "../i18n/config";
import { articlePath, routeAlternates } from "../i18n/routes";
import { t } from "../i18n/ui";
import { getArticlesByLang } from "../utils/articles";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const messages = t(lang);
const articles = await getArticlesByLang(lang);
const dateFormatter = new Intl.DateTimeFormat(INTL_LOCALES[lang], {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={messages.pages.articles.title}
  lang={lang}
  description={messages.pages.articles.description}
  alternates={routeAlternates("articles")}
>
  {articles.length > 0 ? (
    <div class="articles-grid">
      {articles.map(({ article, slug }) => (
        <article class="card-overview">
          <p class="meta-line">
            <span>
              {messages.pages.articles.published}: {dateFormatter.format(article.data.publishedAt)}
            </span>
            <span>
              {messages.pages.articles.tags}: {article.data.tags.join(" · ")}
            </span>
          </p>
          <strong class="article-title">{article.data.title}</strong>
          <div class="article-row">
            <p class="article-description">{article.data.description}</p>
            <a class="button article-button" href={articlePath(lang, slug)}>
              {messages.pages.articles.read}
            </a>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="empty-state">{messages.pages.articles.empty}</p>
  )}
</Layout>

<style>
  .articles-grid {
    width: min(1100px, 100%);
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 1rem;
  }

  /* Same box as the former sl-card: 1.25rem padding, 0.75rem radius, hairline shadow. */
  .card-overview {
    padding: 1.25rem;
    background-color: var(--color-background-card);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-border-gold);
    border-radius: 2px;
  }

  .meta-line {
    margin: 0 0 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-size-xs);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
  }

  .article-title {
    display: block;
    margin: 0 0 0.5rem;
    font-family: var(--font-secondary), sans-serif;
    font-size: var(--text-size-xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-text-main);
  }

  .article-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .article-description {
    margin: 0;
    color: var(--color-text-secondary);
    flex: 1;
    font-size: var(--text-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .article-button {
    flex-shrink: 0;
  }

  .empty-state {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-size-base);
  }

  @media (max-width: 700px) {
    .article-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .article-button {
      width: 100%;
    }
  }
</style>
