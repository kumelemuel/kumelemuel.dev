---
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../i18n/config";
import { routeAlternates } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const messages = t(lang);
---

<Layout
  title={messages.pages.who.title}
  lang={lang}
  description={messages.pages.who.description}
  alternates={routeAlternates("who")}
>
  <section class="bio-wrapper">
    <div class="bio-text" set:html={messages.pages.who.biographyHtml} />
  </section>
</Layout>

<style>
  .bio-wrapper {
    width: min(800px, 100%);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bio-text {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    font-size: var(--text-size-base);
    text-align: center;
  }

  .bio-text :global(p) {
    /* Same gap the previous <br><br> produced (one blank line). */
    margin: 0 0 calc(var(--line-height-relaxed) * 1em);
  }

  .bio-text :global(p:last-child) {
    margin-bottom: 0;
  }

  .bio-text :global(a) {
    /* Underlined so links in running text do not rely on color alone (WCAG 1.4.1). */
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--color-brand-text);
    transition: color 0.2s ease;
  }

  .bio-text :global(a:hover) {
    color: var(--color-brand-hover);
  }
</style>
