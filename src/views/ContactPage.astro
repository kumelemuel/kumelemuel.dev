---
import Layout from "../layouts/Layout.astro";
import ContactSection from "../components/ContactSection.astro";
import ContactForm from "../components/ContactForm.astro";
import type { Lang } from "../i18n/config";
import { routeAlternates } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const messages = t(lang);
---

<Layout
  title={messages.pages.contact.title}
  lang={lang}
  description={messages.pages.contact.intro}
  alternates={routeAlternates("contact")}
>
  <ContactSection intro={messages.pages.contact.intro}>
    <ContactForm lang={lang} />
  </ContactSection>
</Layout>
