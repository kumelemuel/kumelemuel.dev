---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SeoMeta from "../components/SeoMeta.astro";
import { ClientRouter } from "astro:transitions";
import { fade } from "astro:transitions";
import { DEFAULT_LANG, isLang } from "../i18n/config";


const { title, description, lang: requestedLang, noindex } = Astro.props;
const lang = isLang(requestedLang) ? requestedLang : DEFAULT_LANG;
const canonicalURL = Astro.url.href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/themes/light.css" />
		<script type="module" is:inline src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/shoelace-autoloader.js"></script>

		<SeoMeta title={title} description={description} {canonicalURL} {lang} {noindex} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Diego Arenas",
			"url": Astro.site?.href,
			"jobTitle": "Software Engineer",
			"sameAs": [
				"https://github.com/kumelemuel"
			],
			"worksFor": {
				"@type": "Organization",
				"name": "Kumelemuel"
			}
		})} />

		<script type="module" is:inline>
			import { registerIconLibrary } from 'https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.1/cdn/utilities/icon-library.js';
		
			registerIconLibrary('fa', {
				resolver: name => {
					const filename = name.replace(/^fa[rbs]-/, '');
					let folder = 'regular';
					if (name.substring(0, 4) === 'fas-') folder = 'solid';
					if (name.substring(0, 4) === 'fab-') folder = 'brands';
					return `https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@5.15.1/svgs/${folder}/${filename}.svg`;
				},
				mutator: svg => svg.setAttribute('fill', 'currentColor')
			});
		</script>

		<ClientRouter />
	</head>
	<body>
		<Header lang={lang}></Header>
		<main transition:animate={fade({ duration: "0.7s" })}>
			{title && <h1 class="page-title">{title}</h1>}
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>

<style>
	:global(html, body) {
		margin: 0;
		width: 100%;
	}
	body {
		margin: 0;
		width: 100%;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
	}
	Header {
		flex-shrink: 0;
	}
	main {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		padding: var(--margin-page);
		box-sizing: border-box;
		overflow-y: auto;
		overflow-x: hidden;
	}
	.page-title {
		margin: 0 0 var(--margin-element);
	}

	footer {
		transform: translateY(100%);
		transition: transform 0.3s ease;
	}

	footer.visible {
		transform: translateY(0);
	}
</style>

<script>
	const main = document.querySelector('main');
	const footer = document.querySelector('footer');

	if (main && footer) {
		const checkScroll = () => {
			const scrollTop = main.scrollTop;
			const scrollHeight = main.scrollHeight - main.clientHeight;
			
			if (scrollHeight <= 0) {
				footer.classList.add('visible');
			} else {
				const isAtBottom = scrollTop >= scrollHeight - 10;
				footer.classList.toggle('visible', isAtBottom);
			}
		};

		main.addEventListener('scroll', checkScroll);
		checkScroll();
	}
</script>
