---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SeoMeta, { type ArticleMeta } from "../components/SeoMeta.astro";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { DEFAULT_LANG, isLang } from "../i18n/config";
import type { Alternates } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  noindex?: boolean;
  /**
   * Path of this same page in each language it exists in (see src/i18n/routes.ts);
   * drives hreflang and the language switcher. Pass {} for pages without translations.
   */
  alternates: Alternates;
  type?: "website" | "article";
  /** Article dates and tags (only with type="article"). */
  article?: ArticleMeta;
}

const { title, description, lang: requestedLang, noindex, alternates, type, article } = Astro.props;
const lang = isLang(requestedLang) ? requestedLang : DEFAULT_LANG;
const canonicalURL = Astro.url.href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#121212" />
    <Font cssVariable="--font-gruppo" preload={[{ weight: "400" }]} />
    <Font cssVariable="--font-scope-one" preload={[{ weight: "400" }]} />
    <meta name="generator" content={Astro.generator} />

    <SeoMeta
      title={title}
      description={description}
      {canonicalURL}
      {lang}
      {noindex}
      {alternates}
      {type}
      {article}
    />
    <link rel="alternate" type="application/rss+xml" title={t(lang).rss.title} href={`/${lang}/rss.xml`} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t(lang).header.skipToContent}
    </a>
    <Header lang={lang} {alternates} />
    <main id="main" tabindex="-1">
      {title && <h1 class="page-title">{title}</h1>}
      <slot />
    </main>
    <Footer lang={lang} {alternates} />
  </body>
</html>

<style>
  :global(html, body) {
    margin: 0;
    width: 100%;
  }
  body {
    margin: 0;
    width: 100%;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  Header {
    flex-shrink: 0;
  }
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: var(--margin-page);
    box-sizing: border-box;
    overflow-y: hidden;
    overflow-x: hidden;
  }
  .page-title {
    margin: 0 0 var(--margin-element);
  }
</style>
