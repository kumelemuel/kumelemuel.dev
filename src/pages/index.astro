---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="icon-container">
    <sl-icon class="icon-component" name="star" library="fa"></sl-icon>
    <sl-icon class="icon-component" name="heart" library="fa"></sl-icon>
    <sl-icon class="icon-component" name="star" library="fa"></sl-icon>
  </div>
</Layout>

<style>
	.icon-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10rem;
    font-size: 5rem;
    color: var(--color-golden);
    font-weight: 100;
	}
</style>
