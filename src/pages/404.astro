---
import Layout from "../layouts/Layout.astro";

// Static 404: the requested language is unknown at build time, so the page is bilingual.
---

<Layout
  title="Página no encontrada · Page not found"
  description="La página que buscas no existe. The page you are looking for does not exist."
  lang="es"
  alternates={{}}
  noindex
>
  <section class="not-found">
    <p class="code">404</p>

    <div class="message" lang="es">
      <p>
        Este sendero no lleva a ninguna parte. Puede que la página se haya movido o que nunca haya existido.
      </p>
      <a class="button" href="/es/">
        Volver al inicio
      </a>
    </div>

    <div class="message" lang="en">
      <p>This path leads nowhere. The page may have moved, or it never existed.</p>
      <a class="button" href="/en/">
        Back to home
      </a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    width: min(640px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-block);
    text-align: center;
  }

  .code {
    margin: 0;
    font-family: var(--font-secondary), serif;
    font-size: var(--text-size-hero);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-brand-display);
  }

  .message {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-element);
  }

  .message p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    font-size: var(--text-size-base);
  }

  .message[lang="en"] p {
    color: var(--color-text-muted);
  }
</style>
