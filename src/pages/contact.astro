---
import Layout from '../layouts/Layout.astro';

import { Resend } from 'resend';

const resend = new Resend('re_uVUVodYw_9WXEkJmeNFV7CpaWCnkYQt8M');

resend.emails.send({
  from: 'onboarding@resend.dev',
  to: 'kumelemuel@gmail.com',
  subject: 'Hello World',
  html: '<p>Congrats on sending your <strong>first email</strong>!</p>'
});

---
<Layout title="Contact">
  <form action="https://formspree.io/f/xjvjlqzj" method="POST">
    <sl-input name="name" label="Name" required></sl-input>
    <sl-input name="email" label="E-mail" required></sl-input>
    <sl-textarea name="message" label="Message" required></sl-textarea>
    <sl-button type="submit" size="medium" class="contact-button">Send</sl-button>
  </form>
</Layout>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    width: 500px;
  }

  .contact-button::part(base) {
    width: 100%; 
    margin-bottom: 1rem;
    background-color: var(--color-text-accent);
    color: var(--color-text-secondary);
    border: 0;
  }

  .contact-button::part(base):hover {
    background-color: var(--color-text-accent-strong);
  }
</style>