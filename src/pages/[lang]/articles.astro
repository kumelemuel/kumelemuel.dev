---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
const articles = await getCollection('articles');
const getSlugFromId = (id: string) => id.replace(/\.md$/, '');
---

<Layout title={messages.pages.articlesTitle} lang={lang}>
  {articles.length > 0 ? (
    <div class="articles-grid">
      {articles.map((article) => (
        <sl-card class="card-overview">
          <strong>{article.data.title}</strong><br />
          {article.data.description}

          <div slot="footer">
            <sl-button class="article-button" pill href={`/${lang}/articles/${getSlugFromId(article.id)}/`}>
              {messages.pages.articleRead}
            </sl-button>
          </div>
        </sl-card>
      ))}
    </div>
  ) : (
    <p class="empty-state">{messages.pages.articlesEmpty}</p>
  )}
</Layout>

<style>
  .articles-grid {
    width: min(900px, 100%);
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 1rem;
    row-gap: 1rem;
  }

  .card-overview {
    --border-color: var(--color-background-secondary);
    --border-width: 1px;
    --border-radius: 16px;
  }

  .card-overview::part(base) {
    background-color: var(--color-background-secondary);
    color: var(--color-text-secondary);
  }

  .article-button::part(base) {
    background-color: var(--color-text-accent);
    color: var(--color-text-secondary);
    border: 0;
  }

  .article-button::part(base):hover {
    background-color: var(--color-text-accent-strong);
  }

  .card-overview [slot='footer'] {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .empty-state {
    margin: 0;
    color: var(--color-text-gray);
  }

  @media (max-width: 850px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
