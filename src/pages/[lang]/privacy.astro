---
import Layout from '../../layouts/Layout.astro';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
---

<Layout title={messages.pages.privacy.title} lang={lang}>
  <div class="privacy-content" set:html={messages.pages.privacy.bodyHtml}></div>
</Layout>

<style>
  .privacy-content {
    width: min(900px, 100%);
    color: var(--color-text-secondary);
    line-height: 1.55;
  }
  .privacy-content :global(h1) {
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }
  .privacy-content :global(h2) {
    margin: 1.1rem 0 .5rem;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
  }
  .privacy-content :global(p),
  .privacy-content :global(ul) {
    margin: 0 0 .65rem;
  }
</style>
