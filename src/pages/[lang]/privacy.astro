---
import Layout from '../../layouts/Layout.astro';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
---

<Layout title={messages.pages.privacy.title} lang={lang}>
  <div class="privacy-content" set:html={messages.pages.privacy.bodyHtml}></div>
</Layout>

<style>
  .privacy-content {
    width: min(800px, 100%);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    font-size: var(--text-size-base);
  }

  .privacy-content :global(h1) {
    margin: 0 0 var(--margin-block);
    font-family: var(--font-secondary);
    font-size: var(--text-size-4xl);
    font-weight: var(--font-weight-light);
    color: var(--color-text-main);
  }

  .privacy-content :global(h2) {
    margin: var(--margin-block) 0 var(--margin-element);
    font-family: var(--font-secondary);
    font-size: var(--text-size-2xl);
    font-weight: var(--font-weight-light);
    color: var(--color-text-main);
  }

  .privacy-content :global(p),
  .privacy-content :global(ul) {
    margin: 0 0 var(--margin-element);
  }

  .privacy-content :global(a) {
    color: var(--color-brand);
    transition: color 0.2s ease;
  }

  .privacy-content :global(a:hover) {
    color: var(--color-brand-hover);
  }
</style>
