---
import Layout from '../../layouts/Layout.astro';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
---

<Layout title={messages.pages.who.title} lang={lang}>
  <section class="bio-wrapper">
    <p class="bio-text" set:html={messages.pages.who.biographyHtml} />
  </section>
</Layout>

<style>
  .bio-wrapper {
    width: min(990px, 100%);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bio-text {
    margin: 1rem 0 0;
    color: var(--color-text-secondary);
    line-height: 1.4;
    font-size: clamp(.95rem, 1.1vw, 1.05rem);
    text-align: center;
  }
</style>
