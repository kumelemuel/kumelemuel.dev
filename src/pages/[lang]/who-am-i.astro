---
import Layout from '../../layouts/Layout.astro';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
---

<Layout title={messages.pages.who.title} lang={lang} description={lang === 'es' ? 'Ingeniero de software. Mi trabajo profesional se desarrolla dentro de organizaciones privadas, donde diseño e implemento soluciones bajo objetivos, restricciones y marcos ya establecidos.' : 'Software engineer. My professional work takes place within private organizations, where I design and implement solutions under established goals, constraints, and frameworks.'}>
  <section class="bio-wrapper">
    <p class="bio-text" set:html={messages.pages.who.biographyHtml} />
  </section>
</Layout>

<style>
  .bio-wrapper {
    width: min(800px, 100%);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bio-text {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    font-size: var(--text-size-base);
    text-align: center;
  }

  .bio-text :global(a) {
    color: var(--color-brand);
    transition: color 0.2s ease;
  }

  .bio-text :global(a:hover) {
    color: var(--color-brand-hover);
  }
</style>
