---
import Layout from "../../layouts/Layout.astro";
import { SUPPORTED_LANGS, type Lang } from "../../i18n/config";
import { routeAlternates } from "../../i18n/routes";
import { t } from "../../i18n/ui";
import { Picture } from "astro:assets";
import Icon from "../../components/Icon.astro";
import exploringImage from "../../assets/home/exploring.webp";
import designingImage from "../../assets/home/designing.webp";
import craftsmanshipImage from "../../assets/home/craftmanship.webp";

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
---

<Layout lang={lang} description={messages.pages.home.intro} alternates={routeAlternates("home")}>
  <section class="home">
    <div class="hero">
      <p class="eyebrow">{messages.pages.home.eyebrow}</p>
      <h1 class="hero-title">{messages.pages.home.title}</h1>
      <div class="ornament" aria-hidden="true">
        <span></span>
      </div>
      <p class="intro">{messages.pages.home.intro}</p>
    </div>

    <div class="focus-grid">
      <article class="focus-card">
        <div class="card-icon">
          <Icon name="pencil-ruler" />
        </div>
        <h2>{messages.pages.home.card1Title}</h2>
        <p>{messages.pages.home.card1Body}</p>
      </article>
      <article class="focus-card">
        <div class="card-icon">
          <Icon name="globe" />
        </div>
        <h2>{messages.pages.home.card2Title}</h2>
        <p>{messages.pages.home.card2Body}</p>
      </article>
      <article class="focus-card">
        <div class="card-icon">
          <Icon name="users" />
        </div>
        <h2>{messages.pages.home.card3Title}</h2>
        <p>{messages.pages.home.card3Body}</p>
      </article>
    </div>
  </section>

  <section class="feature">
    <h2 class="feature-title">{messages.pages.home.exploreSectionTitle}</h2>
    <Picture
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      src={exploringImage}
      alt={messages.pages.home.exploreImageAlt}
      loading="lazy"
      decoding="async"
      class="feature-image fade-in"
    />
    <p class="feature-text">{messages.pages.home.exploreSectionText}</p>
  </section>

  <section class="feature feature--reverse">
    <h2 class="feature-title">{messages.pages.home.designSectionTitle}</h2>
    <Picture
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      src={designingImage}
      alt={messages.pages.home.designImageAlt}
      loading="lazy"
      decoding="async"
      class="feature-image fade-in"
    />
    <p class="feature-text">{messages.pages.home.designSectionText}</p>
  </section>

  <section class="feature">
    <h2 class="feature-title">{messages.pages.home.craftSectionTitle}</h2>
    <Picture
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      src={craftsmanshipImage}
      alt={messages.pages.home.craftImageAlt}
      loading="lazy"
      decoding="async"
      class="feature-image fade-in"
    />
    <p class="feature-text">{messages.pages.home.craftSectionText}</p>
  </section>

  <section class="bloom-section">
    <div class="bloom-content">
      <h2 class="bloom-title">{messages.pages.home.bloomSectionTitle}</h2>
      <p class="bloom-description">{messages.pages.home.bloomSectionText}</p>
      <div class="ornament bloom-ornament" aria-hidden="true">
        <span></span>
      </div>
      <p class="bloom-closing">{messages.pages.home.bloomClosing}</p>
    </div>
  </section>
</Layout>

<style>
  .home {
    width: min(1200px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-block);
    text-align: center;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-element);
    max-width: 1200px;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-primary), serif;
    font-size: var(--text-size-xs);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-secondary), serif;
    font-size: var(--text-size-hero);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-main);
  }

  .intro {
    margin: 0;
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .focus-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--margin-element);
  }

  .focus-card {
    background: var(--color-background-card);
    border: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border-gold);
    border-radius: 2px;
    padding: var(--margin-block) var(--margin-element);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    text-align: center;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      background-color 0.3s ease;
  }

  .focus-card:hover {
    border-color: var(--color-border-gold);
    transform: translateY(-4px);
    background: var(--color-background-elevated);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-display);
    font-size: 2.5rem;
  }

  .focus-card h2 {
    margin: 0;
    font-family: var(--font-primary), sans-serif;
    font-size: var(--text-size-sm);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    color: var(--color-text-main);
  }

  .focus-card p {
    margin: 0;
    font-size: var(--text-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  /* Stacked cards stay narrow instead of stretching across a tablet screen. */
  @media (max-width: 700px) {
    .focus-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 28rem;
      gap: var(--margin-element);
    }

    .home {
      gap: var(--margin-block);
    }
  }

  /* Feature sections: the DOM order is always title → image → text, which is also the
     reading order on phones. On wide screens the text sits beside the title and image;
     --reverse only swaps the sides visually. */
  .feature {
    container-type: inline-size;
    width: min(1200px, 100%);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "title"
      "image"
      "text";
    justify-items: center;
    row-gap: var(--margin-element);
    padding-block: calc(var(--margin-section) / 2);
    text-align: center;
  }

  /* Section titles share one size. They are single words; the longest ("craftsmanship")
     is ~9.6em wide in Gruppo uppercase, so the size is capped at 1/10 of the available
     width to keep it on one line. .feature and .bloom-section are size containers;
     min(100cqi, 1200px) is the width of a .feature in both, since .bloom-section is not
     capped at 1200px. */
  .feature-title,
  .bloom-title {
    font-size: min(clamp(1.75rem, 1rem + 4vw, 5rem), min(100cqi, 1200px) / 10);
  }

  @media (min-width: 769px) {
    /* Feature titles only get half the width (minus half the column gap); bloom matches them. */
    .feature-title,
    .bloom-title {
      font-size: min(5rem, (min(50cqi, 600px) - var(--margin-block) / 2) / 10);
    }
  }

  .feature-title {
    grid-area: title;
    margin: 0;
    max-width: 100%;
    font-family: var(--font-secondary), serif;
    font-weight: var(--font-weight-regular);
    line-height: 1;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-brand-display);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .feature-image {
    grid-area: image;
    width: min(100%, 460px);
    height: auto;
  }

  .feature-text {
    grid-area: text;
    margin: 0;
    max-width: 60ch;
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  @media (min-width: 769px) {
    .feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "title text"
        "image text";
      column-gap: var(--margin-block);
      align-items: center;
    }

    .feature--reverse {
      grid-template-areas:
        "text title"
        "text image";
    }

    .feature-title {
      align-self: end;
    }

    .feature-image {
      align-self: start;
    }
  }

  .bloom-section {
    container-type: inline-size;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-element);
    padding: var(--margin-block) 0 var(--margin-section);
    text-align: center;
  }

  .bloom-content {
    width: min(1200px, 100%);
    padding: 0 var(--margin-page);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .bloom-title {
    margin: 0 0 var(--margin-element);
    font-family: var(--font-secondary), serif;
    font-weight: var(--font-weight-regular);
    line-height: 1;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-brand-display);
    text-transform: uppercase;
  }

  .bloom-description {
    margin: 0;
    max-width: 800px;
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .bloom-ornament {
    margin-top: var(--margin-block);
  }

  .bloom-closing {
    margin: var(--margin-element) 0 0;
    font-family: var(--font-secondary), serif;
    font-size: var(--text-size-2xl);
    line-height: var(--line-height-snug);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-brand-display);
  }

  /* Images start hidden only when JS can reveal them and the user accepts motion;
     otherwise they are simply visible (no JS, script failure, prefers-reduced-motion). */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .fade-in {
      opacity: 0;
      transform: translateY(70px);
      transition:
        opacity 1.2s ease,
        transform 1.2s ease;
    }

    .fade-in.visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Re-run on every navigation: with ClientRouter, page scripts only execute once.
  function setupFadeIn() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
      },
    );

    document.querySelectorAll(".fade-in:not(.visible)").forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:page-load", setupFadeIn);
</script>
