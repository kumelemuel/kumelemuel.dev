---
import Layout from '../../layouts/Layout.astro';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
---

<Layout lang={lang} description={messages.pages.home.intro}>
  <section class="home">
    <div class="hero">
      <p class="eyebrow">{messages.pages.home.eyebrow}</p>
      <h2 class="hero-title">{messages.pages.home.title}</h2>
      <p class="intro">{messages.pages.home.intro}</p>
    </div>

    <div class="focus-grid">
      <article class="focus-card">
        <div class="card-icon">
          <sl-icon name="fas-pencil-ruler" library="fa"></sl-icon>
        </div>
        <h3>{messages.pages.home.card1Title}</h3>
        <p>{messages.pages.home.card1Body}</p>
      </article>
      <article class="focus-card">
        <div class="card-icon">
          <sl-icon name="fas-globe" library="fa"></sl-icon>
        </div>
        <h3>{messages.pages.home.card2Title}</h3>
        <p>{messages.pages.home.card2Body}</p>
      </article>
      <article class="focus-card">
        <div class="card-icon">
          <sl-icon name="fas-users" library="fa"></sl-icon>
        </div>
        <h3>{messages.pages.home.card3Title}</h3>
        <p>{messages.pages.home.card3Body}</p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .home {
    width: min(1200px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-block);
    text-align: center;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-element);
    max-width: 1200px;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-primary);
    font-size: var(--text-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-secondary),serif;
    font-size: var(--text-size-hero);
    font-weight: var(--font-weight-light);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-main);
  }

  .intro {
    margin: 0;
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .focus-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--margin-element);
  }

  .focus-card {
    background: var(--color-background-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: var(--margin-block) var(--margin-element);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    transition: border-color 0.3s ease, transform 0.3s ease, background-color 0.3s ease;
  }

  .focus-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-4px);
    background: var(--color-background-elevated);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand);
    font-size: 2.5rem;
  }

  .focus-card h3 {
    margin: 0;
    font-family: var(--font-primary);
    font-size: var(--text-size-lg);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-normal);
    color: var(--color-text-main);
  }

  .focus-card p {
    margin: 0;
    font-size: var(--text-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .focus-grid {
      grid-template-columns: 1fr;
      gap: var(--margin-element);
    }

    .home {
      gap: var(--margin-block);
    }
  }
</style>
