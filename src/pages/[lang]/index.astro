---
import Layout from "../../layouts/Layout.astro";
import { SUPPORTED_LANGS, type Lang } from "../../i18n/config";
import { routeAlternates } from "../../i18n/routes";
import { t } from "../../i18n/ui";
import { Picture } from "astro:assets";
import Icon from "../../components/Icon.astro";
import exploringImage from "../../assets/home/exploring.webp";
import designingImage from "../../assets/home/designing.webp";
import craftsmanshipImage from "../../assets/home/craftmanship.webp";

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
---

<Layout lang={lang} description={messages.pages.home.intro} alternates={routeAlternates("home")}>
  <section class="home">
    <div class="hero">
      <p class="eyebrow">{messages.pages.home.eyebrow}</p>
      <h1 class="hero-title">{messages.pages.home.title}</h1>
      <div class="ornament" aria-hidden="true">
        <span></span>
      </div>
      <p class="intro">{messages.pages.home.intro}</p>
    </div>

    <div class="focus-grid">
      <article class="focus-card">
        <div class="card-icon">
          <Icon name="pencil-ruler" />
        </div>
        <h2>{messages.pages.home.card1Title}</h2>
        <p>{messages.pages.home.card1Body}</p>
      </article>
      <article class="focus-card">
        <div class="card-icon">
          <Icon name="globe" />
        </div>
        <h2>{messages.pages.home.card2Title}</h2>
        <p>{messages.pages.home.card2Body}</p>
      </article>
      <article class="focus-card">
        <div class="card-icon">
          <Icon name="users" />
        </div>
        <h2>{messages.pages.home.card3Title}</h2>
        <p>{messages.pages.home.card3Body}</p>
      </article>
    </div>
  </section>

  <section class="explore-split">
    <div class="split-left">
      <h2 class="explore-title">{messages.pages.home.exploreSectionTitle}</h2>
      <Picture
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        src={exploringImage}
        alt={messages.pages.home.exploreImageAlt}
        loading="lazy"
        decoding="async"
        class="fade-in"
      />
    </div>
    <div class="split-right">
      <p class="explore-text">{messages.pages.home.exploreSectionText}</p>
    </div>
  </section>

  <section class="craft-split">
    <div class="split-left">
      <p class="craft-text">{messages.pages.home.designSectionText}</p>
    </div>
    <div class="split-right">
      <h2 class="craft-title">{messages.pages.home.designSectionTitle}</h2>
      <Picture
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        src={designingImage}
        alt={messages.pages.home.designImageAlt}
        loading="lazy"
        decoding="async"
        class="fade-in"
      />
    </div>
  </section>

  <section class="craft-split">
    <div class="split-left">
      <h2 class="craft-title">{messages.pages.home.craftSectionTitle}</h2>
      <Picture
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        src={craftsmanshipImage}
        alt={messages.pages.home.craftImageAlt}
        loading="lazy"
        decoding="async"
        class="fade-in"
      />
    </div>
    <div class="split-right">
      <p class="craft-text">{messages.pages.home.craftSectionText}</p>
    </div>
  </section>

  <section class="bloom-section">
    <div class="bloom-content">
      <h2 class="bloom-title">{messages.pages.home.bloomSectionTitle}</h2>
      <p class="bloom-description">{messages.pages.home.bloomSectionText}</p>
      <div class="ornament bloom-ornament" aria-hidden="true">
        <span></span>
      </div>
      <p class="bloom-closing">{messages.pages.home.bloomClosing}</p>
    </div>
  </section>
</Layout>

<style>
  .home {
    width: min(1200px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-block);
    text-align: center;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-element);
    max-width: 1200px;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-primary), serif;
    font-size: var(--text-size-xs);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-secondary), serif;
    font-size: var(--text-size-hero);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-main);
  }

  .intro {
    margin: 0;
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .focus-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--margin-element);
  }

  .focus-card {
    background: var(--color-background-card);
    border: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border-gold);
    border-radius: 2px;
    padding: var(--margin-block) var(--margin-element);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      background-color 0.3s ease;
  }

  .focus-card:hover {
    border-color: var(--color-border-gold);
    transform: translateY(-4px);
    background: var(--color-background-elevated);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-display);
    font-size: 2.5rem;
  }

  .focus-card h2 {
    margin: 0;
    font-family: var(--font-primary), sans-serif;
    font-size: var(--text-size-sm);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    color: var(--color-text-main);
  }

  .focus-card p {
    margin: 0;
    font-size: var(--text-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .focus-grid {
      grid-template-columns: 1fr;
      gap: var(--margin-element);
    }

    .home {
      gap: var(--margin-block);
    }
  }

  .craft-split {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--margin-block);
    min-height: 60vh;
  }

  .split-left,
  .split-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--margin-block);
  }

  .craft-title {
    margin: 0 0 var(--margin-element);
    font-family: var(--font-secondary), serif;
    font-size: clamp(2.5rem, 6vw, 6rem);
    font-weight: var(--font-weight-regular);
    line-height: 1;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-brand-display);
    text-transform: uppercase;
  }

  .split-left img,
  .split-right img {
    max-width: 100%;
    height: auto;
    border-radius: 1rem;
  }

  .craft-text {
    margin: 0;
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    text-align: center;
  }

  @media (max-width: 768px) {
    .craft-split {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: var(--margin-element);
    }

    .split-left {
      order: 2;
    }

    .split-right {
      order: 1;
    }
  }

  .explore-split {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--margin-block);
    min-height: 60vh;
  }

  .explore-title {
    margin: 0 0 var(--margin-element);
    font-family: var(--font-secondary), serif;
    font-size: clamp(2.5rem, 6vw, 6rem);
    font-weight: var(--font-weight-regular);
    line-height: 1;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-brand-display);
    text-transform: uppercase;
  }

  .explore-split .split-left,
  .explore-split .split-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--margin-block);
  }

  .explore-text {
    margin: 0;
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    text-align: center;
  }

  .explore-split img {
    max-width: 100%;
    height: auto;
    border-radius: 1rem;
  }

  @media (max-width: 768px) {
    .explore-split {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: var(--margin-element);
    }

    .explore-split .split-left {
      order: 2;
    }

    .explore-split .split-right {
      order: 1;
    }
  }

  .bloom-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-element);
    padding: var(--margin-block) 0 var(--margin-section);
    text-align: center;
  }

  .bloom-content {
    width: min(1200px, 100%);
    padding: 0 var(--margin-page);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .bloom-title {
    margin: 0;
    font-family: var(--font-secondary), serif;
    font-size: clamp(2.5rem, 6vw, 6rem);
    font-weight: var(--font-weight-regular);
    line-height: 1;
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-brand-display);
    text-transform: uppercase;
  }

  .bloom-description {
    margin: 0;
    max-width: 800px;
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .bloom-ornament {
    margin-top: var(--margin-block);
  }

  .bloom-closing {
    margin: var(--margin-element) 0 0;
    font-family: var(--font-secondary), serif;
    font-size: var(--text-size-2xl);
    line-height: var(--line-height-snug);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-brand-display);
  }

  /* Images start hidden only when JS can reveal them and the user accepts motion;
     otherwise they are simply visible (no JS, script failure, prefers-reduced-motion). */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .fade-in {
      opacity: 0;
      transform: translateY(70px);
      transition:
        opacity 1.2s ease,
        transform 1.2s ease;
    }

    .fade-in.visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Re-run on every navigation: with ClientRouter, page scripts only execute once.
  function setupFadeIn() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
      },
    );

    document.querySelectorAll(".fade-in:not(.visible)").forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:page-load", setupFadeIn);
</script>
