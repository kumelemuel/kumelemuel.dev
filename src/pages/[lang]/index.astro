---
import Layout from '../../layouts/Layout.astro';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
---

<Layout lang={lang} description={messages.pages.home.intro}>
  <section class="home">
    <div class="hero">
      <p class="eyebrow">{messages.pages.home.eyebrow}</p>
      <h2 class="hero-title">{messages.pages.home.title}</h2>
      <p class="intro">{messages.pages.home.intro}</p>
    </div>

    <div class="focus-grid">
      <article class="focus-card">
        <div class="card-icon">
          <sl-icon name="fas-pencil-ruler" library="fa"></sl-icon>
        </div>
        <h3>{messages.pages.home.card1Title}</h3>
        <p>{messages.pages.home.card1Body}</p>
      </article>
      <article class="focus-card">
        <div class="card-icon">
          <sl-icon name="fas-globe" library="fa"></sl-icon>
        </div>
        <h3>{messages.pages.home.card2Title}</h3>
        <p>{messages.pages.home.card2Body}</p>
      </article>
      <article class="focus-card">
        <div class="card-icon">
          <sl-icon name="fas-users" library="fa"></sl-icon>
        </div>
        <h3>{messages.pages.home.card3Title}</h3>
        <p>{messages.pages.home.card3Body}</p>
      </article>
    </div>
  </section>

  <section class="explore-split">
    <div class="split-left">
      <h2 class="explore-title">Exploration</h2>
      <img
          src="/assets/exploring.webp"
          alt="Exploration illustration"
          loading="lazy"
          decoding="async"
          width="500"
          height="263"
          class="fade-in"
      />
    </div>
    <div class="split-right">
      <p class="explore-text">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p>
    </div>
  </section>

  <section class="craft-split">
    <div class="split-left">
      <p class="craft-text">{messages.pages.home.craftSectionText}</p>
    </div>
    <div class="split-right">
      <h2 class="craft-title">{messages.pages.home.craftSectionTitle}</h2>
      <img
          src="/assets/designing.webp"
          alt="Craftsmanship illustration"
          loading="lazy"
          decoding="async"
          width="500"
          height="286"
          class="fade-in"
      />
    </div>
  </section>

  <section class="craft-split">
    <div class="split-left">
      <h2 class="craft-title">{messages.pages.home.craftSectionTitle}</h2>
      <img
          src="/assets/craftmanship.webp"
          alt="Craftsmanship illustration"
          loading="lazy"
          decoding="async"
          width="500"
          height="291"
          class="fade-in"
      />
    </div>
    <div class="split-right">
      <p class="craft-text">{messages.pages.home.craftSectionText}</p>
    </div>
  </section>

  <section class="bloom-section">
    <div class="bloom-content">
      <h2 class="bloom-title">Bloom</h2>
      <p class="bloom-description">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p>
    </div>
    <img
      src="/assets/bloom.webp"
      alt="Bloom illustration"
      loading="lazy"
      decoding="async"
      class="bloom-image fade-in"
    />
  </section>
</Layout>

<style>
  .home {
    width: min(1200px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-block);
    text-align: center;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-element);
    max-width: 1200px;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-primary),serif;
    font-size: var(--text-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-secondary),serif;
    font-size: var(--text-size-hero);
    font-weight: var(--font-weight-light);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text-main);
  }

  .intro {
    margin: 0;
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .focus-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--margin-element);
  }

  .focus-card {
    background: var(--color-background-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: var(--margin-block) var(--margin-element);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    transition: border-color 0.3s ease, transform 0.3s ease, background-color 0.3s ease;
  }

  .focus-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-4px);
    background: var(--color-background-elevated);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand);
    font-size: 2.5rem;
  }

  .focus-card h3 {
    margin: 0;
    font-family: var(--font-primary),sans-serif;
    font-size: var(--text-size-lg);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-normal);
    color: var(--color-text-main);
  }

  .focus-card p {
    margin: 0;
    font-size: var(--text-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .focus-grid {
      grid-template-columns: 1fr;
      gap: var(--margin-element);
    }

    .home {
      gap: var(--margin-block);
    }
  }

  .craft-split {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--margin-block);
    min-height: 60vh;
  }

  .split-left,
  .split-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--margin-block);
  }

  .craft-title {
    margin: 0 0 var(--margin-element);
    font-family: var(--font-secondary), serif;
    font-size: clamp(3rem, 8vw, 8rem);
    font-weight: var(--font-weight-light);
    line-height: 1;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-brand);
    text-transform: lowercase;
  }

  .split-left img {
    max-width: 100%;
    height: auto;
    border-radius: 1rem;
  }

  .craft-text {
    margin: 0;
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    text-align: center;
  }

  @media (max-width: 768px) {
    .craft-split {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: var(--margin-element);
    }

    .split-left {
      order: 2;
    }

    .split-right {
      order: 1;
    }
  }

  .explore-split {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--margin-block);
    min-height: 60vh;
  }

  .explore-title {
    margin: 0 0 var(--margin-element);
    font-family: var(--font-secondary), serif;
    font-size: clamp(3rem, 8vw, 8rem);
    font-weight: var(--font-weight-light);
    line-height: 1;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-brand);
    text-transform: lowercase;
  }

  .explore-split .split-left,
  .explore-split .split-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--margin-block);
  }

  .explore-text {
    margin: 0;
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    text-align: center;
  }

  .explore-split img {
    max-width: 100%;
    height: auto;
    border-radius: 1rem;
  }

  @media (max-width: 768px) {
    .explore-split {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: var(--margin-element);
    }

    .explore-split .split-left {
      order: 2;
    }

    .explore-split .split-right {
      order: 1;
    }
  }

  .bloom-section {
    width: 100dvw;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-element);
    padding: var(--margin-block) 0 0 0;
    text-align: center;
  }

  .bloom-content {
    width: min(1200px, 100%);
    padding: 0 var(--margin-page);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .bloom-title {
    margin: 0;
    font-family: var(--font-secondary), serif;
    font-size: clamp(3rem, 8vw, 8rem);
    font-weight: var(--font-weight-light);
    line-height: 1;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-brand);
    text-transform: lowercase;
  }

  .bloom-description {
    margin: 0;
    max-width: 800px;
    font-size: var(--text-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .bloom-image {
    width: 100dvw;
    height: auto;
    display: block;
    margin: 0 0 calc(-1 * var(--margin-page)) 0;
  }

  .fade-in {
    opacity: 0;
    transform: translateY(70px);
    transition: opacity 1.2s ease, transform 1.2s ease;
  }

  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  });

  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
</script>
