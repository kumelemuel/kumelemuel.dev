---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
const portfolio = await getCollection('portfolio');
---

<Layout title={messages.pages.portfolioTitle} lang={lang}>
  <div class="portfolio-grid">
    {portfolio.map((project) => (
      <sl-card class="card-overview">
        <img
          slot="image"
          src="https://images.unsplash.com/photo-1559209172-0ff8f6d49ff7?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=500&q=80"
          alt="Project visual"
        />

        <strong>{project.data.title}</strong><br />
        {project.data.description}

        <div slot="footer">
          <sl-button class="portfolio-button" pill href={project.data.url} target="_blank">Visit</sl-button>
        </div>
      </sl-card>
    ))}
  </div>
</Layout>

<style>
  .portfolio-grid {
    width: min(980px, 100%);
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 1rem;
    row-gap: 1rem;
  }
  .card-overview {
    --border-color: var(--color-background-secondary);
    --border-width: 1px;
    --border-radius: 20px;
  }
  .card-overview::part(base) {
    background-color: var(--color-background-secondary);
    color: var(--color-text-secondary);
  }

  .portfolio-button::part(base) {
    background-color: var(--color-text-accent);
    color: var(--color-text-secondary);
    border: 0;
  }

  .portfolio-button::part(base):hover {
    background-color: var(--color-text-accent-strong);
  }

  .card-overview [slot='footer'] {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media (max-width: 850px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
