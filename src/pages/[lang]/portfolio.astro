---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
const portfolio = await getCollection('portfolio');
---

<Layout title={messages.pages.portfolio.title} lang={lang} description={lang === 'es' ? 'Proyectos y aplicaciones desarrolladas, mostrando el trabajo en tecnología al servicio del bien común.' : 'Projects and applications developed, showcasing work in technology in service of the common good.'}>
  <div class="portfolio-grid">
    {portfolio.map((project) => (
      <sl-card class="card-overview">
        <img
          slot="image"
          src="https://images.unsplash.com/photo-1559209172-0ff8f6d49ff7?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=500&q=80"
          alt={messages.pages.portfolio.imageAlt}
        />

        <strong class="project-title">{project.data.title}</strong>
        <p class="project-description">{project.data.description}</p>

        <div slot="footer">
          <sl-button class="portfolio-button" pill href={project.data.url} target="_blank">
            {messages.pages.portfolio.visit}
          </sl-button>
        </div>
      </sl-card>
    ))}
  </div>
</Layout>

<style>
  .portfolio-grid {
    width: min(1100px, 100%);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 1.5rem;
    row-gap: 1.5rem;
  }

  .card-overview {
    --border-color: var(--color-border);
    --border-width: 1px;
    --border-radius: 1rem;
  }

  .card-overview::part(base) {
    background-color: var(--color-background-card);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .project-title {
    display: block;
    font-family: var(--font-secondary),serif;
    font-size: var(--text-size-xl);
    font-weight: var(--font-weight-light);
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }

  .project-description {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .portfolio-button::part(base) {
    background-color: var(--color-brand);
    color: var(--color-text-main);
    border: 0;
    font-weight: var(--font-weight-medium);
  }

  .portfolio-button::part(base):hover {
    background-color: var(--color-brand-hover);
  }

  .card-overview [slot='footer'] {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 1rem;
  }

  @media (max-width: 850px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
