---
import Layout from '../../layouts/Layout.astro';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const title = lang === "es" ? "Términos" : "Terms";
const body =
  lang === "es"
    ? "Esta sección se actualizará próximamente con los términos de servicio."
    : "This section will be updated soon with the terms of service.";
---

<Layout title={title} lang={lang}>
  <p>{body}</p>
</Layout>
