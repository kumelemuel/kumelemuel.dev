---
// DISABLED: the leading "_" keeps this page out of the build until the portfolio is ready.
// Before enabling (rename to portfolio.astro): replace the Unsplash placeholder image with local
// images (the CSP only allows images from this domain) and add the link back to the header menu.
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { SUPPORTED_LANGS, type Lang } from "../../i18n/config";
import { t } from "../../i18n/ui";

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
const portfolio = await getCollection("portfolio");
---

<Layout
  title={messages.pages.portfolio.title}
  lang={lang}
  alternates={{}}
  noindex
  description={messages.pages.portfolio.description}
>
  <div class="portfolio-grid">
    {portfolio.map((project) => (
      <article class="card-overview">
        <img
          class="project-image"
          src="https://images.unsplash.com/photo-1559209172-0ff8f6d49ff7?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=500&q=80"
          alt={messages.pages.portfolio.imageAlt}
        />

        <div class="project-body">
          <strong class="project-title">{project.data.title}</strong>
          <p class="project-description">{project.data.description}</p>
        </div>

        <div class="project-footer">
          <a class="button" href={project.data.url} target="_blank" rel="noopener noreferrer">
            {messages.pages.portfolio.visit}
          </a>
        </div>
      </article>
    ))}
  </div>
</Layout>

<style>
  .portfolio-grid {
    width: min(1100px, 100%);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 1.5rem;
    row-gap: 1.5rem;
  }

  .card-overview {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--color-background-card);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: 2px;
  }

  .project-image {
    width: 100%;
  }

  .project-body {
    padding: 1.25rem;
  }

  .project-title {
    display: block;
    font-family: var(--font-secondary), serif;
    font-size: var(--text-size-xl);
    font-weight: var(--font-weight-light);
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }

  .project-description {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .project-footer {
    padding: 1.25rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 1rem;
  }

  @media (max-width: 850px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
