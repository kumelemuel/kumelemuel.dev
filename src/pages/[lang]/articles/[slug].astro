---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { SUPPORTED_LANGS, type Lang } from '../../../i18n/config';
import { t } from '../../../i18n/ui';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  return SUPPORTED_LANGS.flatMap((lang) =>
    articles.map((article) => ({
      params: {
        lang,
        slug: article.id.replace(/\.md$/, ''),
      },
      props: { article, lang },
    })),
  );
}

const { article, lang } = Astro.props as {
  article: Awaited<ReturnType<typeof getCollection<'articles'>>>[number];
  lang: Lang;
};
const { Content } = await render(article);
const messages = t(lang);
const dateFormatter = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={article.data.title} lang={lang} description={article.data.description}>
  <article class="article">
    <p class="meta-line">
      <span>{messages.pages.articles.published}: {dateFormatter.format(article.data.publishedAt)}</span>
      <span>{messages.pages.articles.tags}: {article.data.tags.join(' · ')}</span>
    </p>
    <p class="description">{article.data.description}</p>
    <div class="article-body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .article {
    width: min(800px, 100%);
    background-color: var(--color-background-card);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: var(--margin-block);
    box-sizing: border-box;
  }

  .description {
    margin: 0 0 var(--margin-element);
    color: var(--color-text-muted);
    font-size: var(--text-size-base);
    line-height: var(--line-height-relaxed);
  }

  .meta-line {
    margin: 0 0 var(--margin-element);
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-size-xs);
    letter-spacing: 0.02em;
  }

  .article-body {
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    font-size: var(--text-size-base);
  }

  .article-body :global(p) {
    margin: 0 0 var(--margin-element);
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    font-family: var(--font-secondary),sans-serif;
    font-weight: var(--font-weight-light);
    color: var(--color-text-main);
    margin: var(--margin-block) 0 var(--margin-element);
  }

  .article-body :global(h2) {
    font-size: var(--text-size-2xl);
  }

  .article-body :global(h3) {
    font-size: var(--text-size-xl);
  }

  .article-body :global(a) {
    color: var(--color-brand);
    transition: color 0.2s ease;
  }

  .article-body :global(a:hover) {
    color: var(--color-brand-hover);
  }

  .article-body :global(code) {
    background: var(--color-background-elevated);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  .article-body :global(pre) {
    background: var(--color-background-elevated);
    padding: var(--margin-element);
    border-radius: 0.5rem;
    overflow-x: auto;
  }

  .article-body :global(pre code) {
    background: none;
    padding: 0;
  }
</style>
