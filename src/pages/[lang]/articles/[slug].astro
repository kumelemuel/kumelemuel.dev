---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { SUPPORTED_LANGS, type Lang } from '../../../i18n/config';
import { t } from '../../../i18n/ui';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  return SUPPORTED_LANGS.flatMap((lang) =>
    articles.map((article) => ({
      params: {
        lang,
        slug: article.id.replace(/\.md$/, ''),
      },
      props: { article, lang },
    })),
  );
}

const { article, lang } = Astro.props as {
  article: Awaited<ReturnType<typeof getCollection>>[number];
  lang: Lang;
};
const { Content } = await render(article);
const messages = t(lang);
const dateFormatter = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={article.data.title} lang={lang}>
  <article class="article">
    <p class="meta-line">
      <span>{messages.pages.articles.published}: {dateFormatter.format(article.data.publishedAt)}</span>
      <span>{messages.pages.articles.tags}: {article.data.tags.join(' · ')}</span>
    </p>
    <p class="description">{article.data.description}</p>
    <div class="article-body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .article {
    width: min(800px, 100%);
    background-color: var(--color-background-secondary);
    border: 1px solid var(--color-gray-strong);
    border-radius: 16px;
    padding: 1.2rem;
    box-sizing: border-box;
  }

  .description {
    margin: 0 0 .9rem;
    color: var(--color-text-gray);
    font-size: .95rem;
    line-height: 1.45;
  }

  .meta-line {
    margin: 0 0 .45rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    color: var(--color-text-gray);
    font-size: .82rem;
  }

  .article-body {
    color: var(--color-text-secondary);
    line-height: 1.6;
    font-size: 1rem;
  }

  .article-body :global(p) {
    margin: 0 0 .8rem;
  }
</style>
