---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import ContactForm from '../../components/ContactForm.astro';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
---

<Layout title={messages.pages.contact.title} lang={lang} description={messages.pages.contact.intro}>
  <ContactSection intro={messages.pages.contact.intro}>
    <ContactForm lang={lang} />
  </ContactSection>
</Layout>

