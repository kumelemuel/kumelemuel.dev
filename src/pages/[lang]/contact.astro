---
import Layout from '../../layouts/Layout.astro';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
---
<Layout title={messages.pages.contact.title} lang={lang}>
  <section class="contact-wrapper">
    <p class="contact-intro">{messages.pages.contact.intro}</p>

    <form
      class="contact-form"
      action="https://formspree.io/f/xjvjlqzj"
      method="POST"
    >
      <sl-input
        name="name"
        label={messages.pages.contact.name}
        placeholder={messages.pages.contact.namePlaceholder}
        autocomplete="name"
        required
      ></sl-input>

      <sl-input
        name="email"
        type="email"
        label={messages.pages.contact.email}
        placeholder={messages.pages.contact.emailPlaceholder}
        autocomplete="email"
        required
      ></sl-input>

      <sl-input
        name="phone"
        type="tel"
        label={messages.pages.contact.phone}
        placeholder={messages.pages.contact.phonePlaceholder}
        help-text={messages.pages.contact.phoneHelp}
        autocomplete="tel"
      ></sl-input>

      <sl-textarea
        name="message"
        label={messages.pages.contact.message}
        placeholder={messages.pages.contact.messagePlaceholder}
        rows="5"
        required
      ></sl-textarea>

      <sl-button type="submit" size="medium" class="contact-button">{messages.pages.contact.send}</sl-button>
    </form>
  </section>
</Layout>

<style>
  .contact-wrapper {
    width: min(760px, 100%);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-intro {
    margin: 0;
    color: var(--color-text-gray);
    text-align: center;
    line-height: 1.5;
    font-size: .98rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    width: min(620px, 100%);
    margin: 0 auto;
  }

  .contact-button::part(base) {
    width: 100%; 
    background-color: var(--color-text-accent);
    color: var(--color-text-secondary);
    border: 0;
  }

  .contact-button::part(base):hover {
    background-color: var(--color-text-accent-strong);
  }
</style>
