---
import Layout from '../../layouts/Layout.astro';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
---
<Layout title={messages.pages.contactTitle} lang={lang}>
  <section class="contact-wrapper">
    <p class="contact-intro">{messages.pages.contactIntro}</p>

    <form
      class="contact-form"
      action="https://formspree.io/f/xjvjlqzj"
      method="POST"
    >
      <sl-input
        name="name"
        label={messages.pages.contactName}
        placeholder={messages.pages.contactNamePlaceholder}
        autocomplete="name"
        required
      ></sl-input>

      <sl-input
        name="email"
        type="email"
        label={messages.pages.contactEmail}
        placeholder={messages.pages.contactEmailPlaceholder}
        autocomplete="email"
        required
      ></sl-input>

      <sl-input
        name="phone"
        type="tel"
        label={messages.pages.contactPhone}
        placeholder={messages.pages.contactPhonePlaceholder}
        help-text={messages.pages.contactPhoneHelp}
        autocomplete="tel"
      ></sl-input>

      <sl-textarea
        name="message"
        label={messages.pages.contactMessage}
        placeholder={messages.pages.contactMessagePlaceholder}
        rows="5"
        required
      ></sl-textarea>

      <sl-button type="submit" size="medium" class="contact-button">{messages.pages.contactSend}</sl-button>
    </form>
  </section>
</Layout>

<style>
  .contact-wrapper {
    width: min(760px, 100%);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-intro {
    margin: 0;
    color: var(--color-text-gray);
    text-align: center;
    line-height: 1.5;
    font-size: .98rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    width: min(620px, 100%);
    margin: 0 auto;
  }

  .contact-button::part(base) {
    width: 100%; 
    background-color: var(--color-text-accent);
    color: var(--color-text-secondary);
    border: 0;
  }

  .contact-button::part(base):hover {
    background-color: var(--color-text-accent-strong);
  }
</style>
