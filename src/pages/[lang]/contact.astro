---
import Layout from '../../layouts/Layout.astro';
import { SUPPORTED_LANGS, type Lang } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { actions } from 'astro:actions';

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const messages = t(lang);
---

<Layout title={messages.pages.contact.title} lang={lang} description={lang === 'es' ? 'Estoy abierto a colaborar en proyectos que valoren el criterio, la claridad y el impacto humano del software. Si crees que podemos construir algo con sentido, conversemos.' : 'I am open to collaborating on projects that value judgment, clarity, and the human impact of software. If you think we can build something meaningful, let\'s talk.'}>
  <section class="contact-wrapper">
    <p class="contact-intro">{messages.pages.contact.intro}</p>

    <form
      class="contact-form"
      action={actions.contact}
      method="POST"
      data-unexpected-error={messages.pages.contact.submitUnexpectedError}
      data-network-error={lang === 'es' ? 'No pudimos conectar con el servidor. Revisa tu conexión e inténtalo de nuevo.' : 'Could not connect to the server. Check your connection and try again.'}
      data-timeout-error={lang === 'es' ? 'La solicitud tardó demasiado. Inténtalo nuevamente.' : 'The request took too long. Please try again.'}
      data-sending-label={lang === 'es' ? 'Enviando...' : 'Sending...'}
      data-success-title={lang === 'es' ? 'Mensaje enviado correctamente.' : 'Message sent successfully.'}
      novalidate
    >
      <p class="form-error" data-form-error aria-live="polite"></p>
      <p class="form-success" data-form-success aria-live="polite"></p>
      <input type="hidden" name="lang" value={lang} />
      <sl-input
        name="name"
        label={messages.pages.contact.name}
        placeholder={messages.pages.contact.namePlaceholder}
        autocomplete="name"
      ></sl-input>
      <p class="field-error" data-error-for="name" aria-live="polite"></p>

      <sl-input
        name="email"
        type="text"
        label={messages.pages.contact.email}
        placeholder={messages.pages.contact.emailPlaceholder}
        autocomplete="email"
      ></sl-input>
      <p class="field-error" data-error-for="email" aria-live="polite"></p>

      <sl-input
        name="phone"
        type="tel"
        label={messages.pages.contact.phone}
        placeholder={messages.pages.contact.phonePlaceholder}
        help-text={messages.pages.contact.phoneHelp}
        autocomplete="tel"
      ></sl-input>
      <p class="field-error" data-error-for="phone" aria-live="polite"></p>

      <sl-textarea
        name="message"
        label={messages.pages.contact.message}
        placeholder={messages.pages.contact.messagePlaceholder}
        rows="5"
      ></sl-textarea>
      <p class="field-error" data-error-for="message" aria-live="polite"></p>

      <sl-button type="submit" size="medium" class="contact-button">{messages.pages.contact.send}</sl-button>
    </form>
  </section>
</Layout>

<style>
  .contact-wrapper {
    width: min(760px, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--margin-block);
  }

  .contact-intro {
    margin: 0;
    color: var(--color-text-muted);
    text-align: center;
    line-height: var(--line-height-relaxed);
    font-size: var(--text-size-base);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(620px, 100%);
    margin: 0 auto;
  }

  .contact-button::part(base) {
    width: 100%;
    background-color: var(--color-brand);
    color: var(--color-text-main);
    border: 0;
    font-weight: var(--font-weight-medium);
  }

  .contact-button::part(base):hover {
    background-color: var(--color-brand-hover);
  }

  .field-error {
    margin: 0;
    font-size: var(--text-size-xs);
    color: var(--color-error);
    min-height: 0;
    line-height: 1.4;
  }

  .form-error {
    margin: 0 0 0.5rem;
    font-size: var(--text-size-sm);
    color: var(--color-error);
    font-weight: var(--font-weight-medium);
    text-align: left;
    min-height: 0;
    line-height: 1.4;
  }

  .form-success {
    margin: 0 0 0.5rem;
    font-size: var(--text-size-sm);
    color: var(--color-success);
    font-weight: var(--font-weight-medium);
    text-align: left;
    min-height: 0;
    line-height: 1.4;
  }

  sl-input.is-invalid::part(base),
  sl-textarea.is-invalid::part(base) {
    border-color: var(--color-error);
    box-shadow: 0 0 0 1px var(--color-error) inset;
  }

  .contact-form.is-submitting {
    opacity: 0.88;
  }
</style>

<script>
  import { actions, isInputError } from 'astro:actions';

  const form = document.querySelector('.contact-form');

  if (form instanceof HTMLFormElement) {
    const submitButton = form.querySelector('sl-button[type="submit"]');
    const defaultButtonText = submitButton ? submitButton.textContent || '' : '';

    const isEs = form.querySelector('input[name="lang"]')?.getAttribute('value') === 'es';
    const genericError = form.dataset.unexpectedError || 'Unexpected error';
    const genericNetworkError = form.dataset.networkError || genericError;
    const genericTimeoutError = form.dataset.timeoutError || genericError;

    const setSubmitting = (submitting: boolean) => {
      form.classList.toggle('is-submitting', submitting);
      if (submitButton) {
        (submitButton as HTMLButtonElement).disabled = submitting;
        (submitButton as any).loading = submitting;
        submitButton.textContent = submitting
          ? form.dataset.sendingLabel || (isEs ? 'Enviando...' : 'Sending...')
          : defaultButtonText;
      }
    };

    const clearNotices = () => {
      const formErrorEl = form.querySelector('[data-form-error]');
      if (formErrorEl instanceof HTMLElement) {
        formErrorEl.textContent = '';
      }
      const formSuccessEl = form.querySelector('[data-form-success]');
      if (formSuccessEl instanceof HTMLElement) {
        formSuccessEl.textContent = '';
      }
    };

    const clearErrors = () => {
      clearNotices();

      const errorEls = form.querySelectorAll('[data-error-for]');
      for (const errorEl of errorEls) {
        if (errorEl instanceof HTMLElement) {
          errorEl.textContent = '';
        }
      }

      const fields = form.querySelectorAll('sl-input, sl-textarea');
      for (const field of fields) {
        field.classList.remove('is-invalid');
        field.removeAttribute('aria-invalid');
        if (typeof (field as any).setCustomValidity === 'function') {
          (field as any).setCustomValidity('');
        }
      }
    };

    const setFieldError = (name: string, message: string) => {
      const errorEl = form.querySelector(`[data-error-for="${name}"]`);
      if (errorEl instanceof HTMLElement) {
        errorEl.textContent = message;
      }

      const field = form.querySelector(`[name="${name}"]`);
      if (field && typeof (field as any).setCustomValidity === 'function') {
        (field as any).setCustomValidity(message);
      }
      if (field instanceof HTMLElement) {
        field.classList.add('is-invalid');
        field.setAttribute('aria-invalid', 'true');
      }
    };

    const setFormError = (message: string) => {
      clearNotices();
      const formErrorEl = form.querySelector('[data-form-error]');
      if (formErrorEl instanceof HTMLElement) {
        formErrorEl.textContent = message;
      }
    };

    const setFormSuccess = (message: string) => {
      clearNotices();
      const formSuccessEl = form.querySelector('[data-form-success]');
      if (formSuccessEl instanceof HTMLElement) {
        formSuccessEl.textContent = message;
      }
    };

    const focusFirstInvalidField = () => {
      const firstInvalid = form.querySelector('sl-input.is-invalid, sl-textarea.is-invalid');
      if (firstInvalid instanceof HTMLElement) {
        if (typeof firstInvalid.focus === 'function') {
          firstInvalid.focus();
        }
        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    };

    const normalizeMessages = (value: unknown) => {
      if (Array.isArray(value)) {
        return value.filter((msg) => typeof msg === 'string' && msg.length > 0);
      }
      if (typeof value === 'string' && value.length > 0) {
        return [value];
      }
      return [];
    };

    const withTimeout = (promise: Promise<unknown>, ms: number) =>
      Promise.race([
        promise,
        new Promise((_, reject) => {
          window.setTimeout(() => reject(new Error('ACTION_TIMEOUT')), ms);
        }),
      ]);

    form.addEventListener('input', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const name = target.getAttribute('name');
      if (!name) return;

      const errorEl = form.querySelector(`[data-error-for="${name}"]`);
      if (errorEl instanceof HTMLElement) {
        errorEl.textContent = '';
      }

      target.classList.remove('is-invalid');
      target.removeAttribute('aria-invalid');

      if (typeof (target as any).setCustomValidity === 'function') {
        (target as any).setCustomValidity('');
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      setSubmitting(true);

      try {
        const formData = new FormData(form);
        const { data, error } = await withTimeout(actions.contact(formData), 12000) as any;

        if (error) {
          if (isInputError(error)) {
            let hasFieldErrors = false;

            for (const [fieldName, rawMessages] of Object.entries(error.fields ?? {})) {
              const msgs = normalizeMessages(rawMessages);
              if (msgs.length === 0) continue;
              hasFieldErrors = true;
              setFieldError(fieldName, msgs[0]);
            }

            if (!hasFieldErrors && Array.isArray(error.issues)) {
              for (const issue of error.issues) {
                const path = Array.isArray(issue.path) ? issue.path[0] : undefined;
                const msg = typeof issue.message === 'string' ? issue.message : '';
                if (typeof path === 'string' && msg) {
                  hasFieldErrors = true;
                  setFieldError(path, msg);
                }
              }
            }

            if (!hasFieldErrors) {
              setFormError(
                typeof error.message === 'string' && error.message.length > 0
                  ? error.message
                  : genericError,
              );
            } else {
              focusFirstInvalidField();
            }
            return;
          }
          setFormError(
            typeof error.message === 'string' && error.message.length > 0
              ? error.message
              : genericError,
          );
          return;
        }

        if (data?.ok) {
          const successMessage =
            typeof data.message === 'string' && data.message.length > 0
              ? `${form.dataset.successTitle || ''} ${data.message}`.trim()
              : form.dataset.successTitle || '';
          setFormSuccess(successMessage);
          form.reset();
          return;
        }
        setFormError(genericError);
      } catch (caughtError) {
        if (caughtError instanceof Error && caughtError.message === 'ACTION_TIMEOUT') {
          setFormError(genericTimeoutError);
          return;
        }
        if (!navigator.onLine) {
          setFormError(genericNetworkError);
          return;
        }
        setFormError(genericError);
      } finally {
        setSubmitting(false);
      }
    });
  }
</script>
