---
import type { InferGetStaticPropsType } from "astro";
import ArticlePage from "../../../views/ArticlePage.astro";
import { getArticleStaticPaths } from "../../../utils/articles";

export const getStaticPaths = () => getArticleStaticPaths("en");

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { article, alternates } = Astro.props;
---

<ArticlePage lang="en" {article} {alternates} />
